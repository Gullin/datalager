FME_PYTHON_VERSION 310
ARCGIS_COMPATIBILITY ARCGIS_AUTO
# ============================================================================
DEFAULT_MACRO RotDirectory ../

DEFAULT_MACRO ProcessName 

DEFAULT_MACRO ProcessModulName 

DEFAULT_MACRO RepositoryRotDir 

DEFAULT_MACRO ProcessModuleClippArea 

DEFAULT_MACRO DistSourceFile 

DEFAULT_MACRO IsWholeProcessRun 1

# ============================================================================
INCLUDE [ if {{$(RotDirectory$encode)} == {}} { puts_real {Parameter 'RotDirectory' must be given a value.}; exit 1; }; ]
INCLUDE [ if {{$(RepositoryRotDir$encode)} == {}} { puts_real {Parameter 'RepositoryRotDir' must be given a value.}; exit 1; }; ]
INCLUDE [ if {{$(ProcessModuleClippArea$encode)} == {}} { puts_real {Parameter 'ProcessModuleClippArea' must be given a value.}; exit 1; }; ]
INCLUDE [ if {{$(DistSourceFile$encode)} == {}} { puts_real {Parameter 'DistSourceFile' must be given a value.}; exit 1; }; ]
#! START_HEADER
#! START_WB_HEADER
READER_TYPE MULTI_READER
WRITER_TYPE NULL
WRITER_KEYWORD NULL_DEST
NULL_DEST_DATASET null
#! END_WB_HEADER
#! START_WB_HEADER
#! END_WB_HEADER
#! END_HEADER

LOG_FILENAME "$(RotDirectory)_log/FME-$(FME_MF_NAME).log"
LOG_APPEND NO
LOG_TIMINGS YES
LOG_FILTER_MASK -1
LOG_MAX_FEATURES 200
LOG_MAX_RECORDED_FEATURES 200
FME_REPROJECTION_ENGINE FME
FME_IMPLICIT_CSMAP_REPROJECTION_MODE Auto
FME_GEOMETRY_HANDLING Enhanced
FME_STROKE_MAX_DEVIATION 0
FME_NAMES_ENCODING UTF-8
FME_BULK_MODE_THRESHOLD 2000
LAST_SAVE_BUILD "FME 2022.2.0.0 (20221103 - Build 22765 - WIN64)"
# -------------------------------------------------------------------------

MULTI_READER_CONTINUE_ON_READER_FAILURE No

