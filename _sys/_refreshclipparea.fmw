Tcl2 proc StringConcatenator_7_evaluator {} {    if {{OUTGOING} == {OUTGOING}} {      set attr [FME_DecodeText {Logg}];      if {[string length $attr] == 0} { return; };      set attrs [list [FME_EncodeText $attr]];    } else {      set attrAll {<Unused>};      if {[string length $attrAll] == 0} { return; };      set attrs [split {<Unused>} { }];    };    set parmList {{EvaluateExpression} {ATTR_CREATE_EXPR_PROPOGATE_MISSING_FDIV}};    foreach attr $attrs {     lappend parmList $attr;     lappend parmList {"Fel<space>vid<space>l<u00e4>sning<space>av<space>dataset<space>fr<u00e5>n<space><quote><at>Value<openparen>_pathFileClippArea<closeparen><quote>.<space>Fel:<space><lf><at>Value<openparen>_reader_error<closeparen>"};    };    lappend parmList {StringConcatenator_7};    eval FME_Execute $parmList; }
