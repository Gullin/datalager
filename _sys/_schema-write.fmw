Tcl2 proc $(NamingConvention_WORKSPACE_NAME)_ListPopulator_builder {} {    set attrExp \"^naming_convention_deviation_(\[0-9\]*)\$\";    set listIndex 0;    foreach name [lsort -dictionary [FME_AttributeNames]] {        if [regexp $attrExp $name all idx] {          set rootName \"_list{$listIndex}\";          set attrVal [FME_GetAttribute $name];          if {$attrVal == {} && [FME_IsAttributeNull $name]}          {          		FME_SetAttributeNull $rootName;          } else {          		FME_SetAttribute $rootName $attrVal;          };          incr listIndex;        };    }; }
