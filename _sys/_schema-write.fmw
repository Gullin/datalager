Tcl2 set $(NamingConvention_WORKSPACE_NAME)_ListConcatenator__separator [FME_DecodeText {<comma>}];      regsub -all \"{}\" [FME_DecodeText {_list<opencurly><closecurly>}] [FME_DecodeText {<opencurly><backslash>d+<closecurly>}] $(NamingConvention_WORKSPACE_NAME)_ListConcatenator__listPattern;      set $(NamingConvention_WORKSPACE_NAME)_ListConcatenator__listPattern ^$$(NamingConvention_WORKSPACE_NAME)_ListConcatenator__listPattern$;
Tcl2 proc $(NamingConvention_WORKSPACE_NAME)_ListConcatenator__Concatenate {} {   upvar \#0 $(NamingConvention_WORKSPACE_NAME)_ListConcatenator__separator separator             $(NamingConvention_WORKSPACE_NAME)_ListConcatenator__listPattern listPattern;   set allAttrs [lsort -dictionary [FME_AttributeNames]];   set keepEmptyParts [string equal {No} {No}];   set result {};   foreach attrName $allAttrs {     if {[regexp $listPattern $attrName]} {       set attrValue [FME_GetAttribute $attrName];       if {$keepEmptyParts || $attrValue != {}} {         lappend result $attrValue;       };     };   };   FME_SetAttribute {"_naming_convention"} [join $result $separator]; }
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(NamingConvention_WORKSPACE_NAME)_ListConcatenator }    INPUT  FEATURE_TYPE "$(NamingConvention_WORKSPACE_NAME)_ListPopulator_OUTPUT"    OUTPUT { FEATURE_TYPE "$(NamingConvention_WORKSPACE_NAME)_ListConcatenator_OUTPUT"         @Tcl2($(NamingConvention_WORKSPACE_NAME)_ListConcatenator__Concatenate)          }
# -------------------------------------------------------------------------
# Build the List removal function and regular expression if there was any list attributes to be removed.
# If not, then we will not have any extra list removal call to @RemoveAttributes, which speeds the
# normal, non-list removal especially when in Bulk Mode.  Note that this computation of the regular expressions is done
# once during mapping file parse time.
INCLUDE [    set listAttributeRemoveRegexps {};    set anyList {no};    foreach attr [split "_list<opencurly><closecurly>"] {       set attr [FME_DecodeText $attr];       set attr [regsub "{}$" $attr "{}.*"];       set attr [regsub -all "{}" $attr "\\{\[0-9\]+\\}"];       append listAttributeRemoveRegexps ",^$attr$";       set anyList {yes};    };    if { ${anyList} == {no} } {        puts {MACRO $(NamingConvention_WORKSPACE_NAME)_AttributeRemover_LIST_FUNC }    } else {        puts "MACRO $(NamingConvention_WORKSPACE_NAME)_AttributeRemover_LIST_FUNC @RemoveAttributes(fme_pcre_match\"$listAttributeRemoveRegexps\")"    }; ]
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(NamingConvention_WORKSPACE_NAME)_AttributeRemover }    INPUT  FEATURE_TYPE "$(NamingConvention_WORKSPACE_NAME)_ListConcatenator_OUTPUT"    OUTPUT { FEATURE_TYPE "$(NamingConvention_WORKSPACE_NAME)_AttributeRemover_OUTPUT"        @RemoveAttributes(fme_encoded,attribut,naming_convention_deviation_0,naming_convention_deviation_1,naming_convention_deviation_2,naming_convention_deviation_3,naming_convention_deviation_4)        $($(NamingConvention_WORKSPACE_NAME)_AttributeRemover_LIST_FUNC)         }
