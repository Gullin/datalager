Tcl2 proc StringConcatenator_2_evaluator {} {    if {{OUTGOING} == {OUTGOING}} {      set attr [FME_DecodeText {Logg}];      if {[string length $attr] == 0} { return; };      set attrs [list [FME_EncodeText $attr]];    } else {      set attrAll {<Unused>};      if {[string length $attrAll] == 0} { return; };      set attrs [split {<Unused>} { }];    };    set parmList {{EvaluateExpression} {ATTR_CREATE_EXPR_PROPOGATE_MISSING_FDIV}};    foreach attr $attrs {     lappend parmList $attr;     lappend parmList {"Kartl<u00e4>gger<space>schemastruktur<space>f<u00f6>r<space>dataseten<space><at>Value<openparen>fme_dataset_concatenated<closeparen><space><openparen>totalt<space><at>Value<openparen>TotaltAntal<closeparen><space>st.<closeparen><space>efter<space>inparametern<space><quote><at>Value<openparen>InData<closeparen><quote>."};    };    lappend parmList {StringConcatenator_2};    eval FME_Execute $parmList; }
