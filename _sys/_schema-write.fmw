Tcl2 proc Logg_7_27f5e902_51a7_4def_9c3d_ed40739c5cb60_summarizer { } {     global Logg_7_27f5e902_51a7_4def_9c3d_ed40739c5cb60_process_count;     set comment { incr 0 creates the variable if it wasn't present };     incr Logg_7_27f5e902_51a7_4def_9c3d_ed40739c5cb60_process_count 0;     FME_SetAttribute _proc_count [set Logg_7_27f5e902_51a7_4def_9c3d_ed40739c5cb60_process_count];     global Logg_7_27f5e902_51a7_4def_9c3d_ed40739c5cb60_all_processes;     if {[info exists Logg_7_27f5e902_51a7_4def_9c3d_ed40739c5cb60_all_processes]} {         set index 0;         foreach pid [set Logg_7_27f5e902_51a7_4def_9c3d_ed40739c5cb60_all_processes] {             FME_SetAttribute \"_processes{$index}\" $pid;             incr index;         }     } }
