DEFAULT_MACRO RotDirectory ../
DEFAULT_MACRO ProcessName 
DEFAULT_MACRO DataFormat 
DEFAULT_MACRO InData LKR_GIS
DEFAULT_MACRO InData-DatabaseTable 
DEFAULT_MACRO InData_Alternative 1.0.0
DEFAULT_MACRO OutSchemaFileNameSuffix flush
DEFAULT_MACRO OutputDirectory 
DEFAULT_MACRO ProcessModulName 
DEFAULT_MACRO IsWholeProcessRun 1
DEFAULT_MACRO XLSXW_OUT_OVERWRITE_FILE_XLSXW Yes
DEFAULT_MACRO ENFORCE_NAMING_CONVENTION false
DEFAULT_MACRO FME_USER_PARAM_PRIVATE_GRP 
DEFAULT_MACRO OutSchemaFileName schema-$(OutSchemaFileNameSuffix)
DEFAULT_MACRO OutSchemaFileExtention .xlsx
DEFAULT_MACRO Out $(OutputDirectory)$(OutSchemaFileName)$(OutSchemaFileExtention)
