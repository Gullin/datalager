MACRO casemac
INCLUDE [ if { {no} == {no} } { puts {MACRO casemac -nocase}} ]
Tcl2 proc $(NamingConvention_WORKSPACE_NAME)_StringPairReplacer_2_ed344991_f0bb_4326_a60b_0683c6ad0efd1_replace {} {    set attrs [split {_attribut_new} { }];    set mapping [FME_DecodeText {"<u00e5><space>a<space><u00e4><space>a<space><u00f6><space>o"}];    foreach attr $attrs {       set attrName [FME_DecodeText $attr];       FME_SetAttribute $attrName [string map $(casemac) $mapping [FME_GetAttribute $attrName]];    }; }
