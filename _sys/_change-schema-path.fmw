#! <SUBDOCUMENT
#!   NAME="FileExistenceChecker"
#!   ARCGIS_COMPATIBILITY="ARCGIS_AUTO"
#!   CATEGORY="Filters and Joins"
#!   DESCRIPTION="&lt;h3&gt;Description&lt;/h3&gt;&#10;&lt;p&gt;This transformer checks if input file paths exist and routes features accordingly.&#10;The transformer supports UNC path, Zip files(*.zip) and wildcards. &lt;/p&gt;&#10;&lt;h3&gt;Details&lt;/h3&gt;&#10;&lt;p&gt;The transformer will check if the filename selected in InputPort exists or not. &#10;The path can be supplied from a parameter, a network share location, by selecting a filename or using wildcards. &lt;/p&gt;&#10;&lt;h3&gt;Notes&lt;/h3&gt;&#10;&lt;ul&gt;&#10;&lt;li&gt;Multiple filenames are not supported&lt;/li&gt;&#10;&lt;li&gt;Path to file must exist (no missing folders in the path)&lt;/li&gt;&#10;&lt;li&gt;FTP paths are not supported&lt;/li&gt;&#10;&lt;/ul&gt;"
#!   DOC_DYNAMIC_INPUT_ATTRS="0"
#!   DOC_EXTENTS="3403 502.746"
#!   DOC_TOP_LEFT="122 -865.75"
#!   FME_DOCUMENT_GUID="72f82949-cc93-45ae-b257-dcb0c2bde9a4"
#!   FME_DOCUMENT_PRIORGUID="25285178-bb62-4d7c-a3ae-4a75539356ce"
#!   FME_NAMES_ENCODING="UTF-8"
#!   FME_PROCESS_COUNT="NO_PARALLELISM"
#!   FME_PROCESS_GROUPS_ORDERED="No"
#!   FME_PROCESS_GROUP_BY=""
#!   FME_PROCESS_PRESERVE_GROUP_ATTR="No"
