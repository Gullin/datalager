FACTORY_DEF {*} AggregateFactory    FACTORY_NAME { Aggregator_4 }    INPUT  FEATURE_TYPE FeatureReader_<REJECTED>    MODE { ONE_LEVEL }    GROUP_BY { ProcessID ProcessName RotDirectory }    FLUSH_WHEN_GROUPS_CHANGE { No }    REMOVE_GEOMETRY { NO }    ACCUMULATE_ATTRIBUTES { None }    LIST_ATTRS_TO_INCLUDE { <Unused> }    LIST_ATTRS_TO_INCLUDE_MODE { <Unused> }    CONCATENATE_FIELDS { _reader_error }    SEPARATOR { <lf> }    PRODUCE_MULTIS { YES }    OUTPUT { AGGREGATE FEATURE_TYPE Aggregator_4_AGGREGATE          }
# -------------------------------------------------------------------------
Tcl2 proc StringConcatenator_4_evaluator {} {    if {{OUTGOING} == {OUTGOING}} {      set attr [FME_DecodeText {Logg}];      if {[string length $attr] == 0} { return; };      set attrs [list [FME_EncodeText $attr]];    } else {      set attrAll {<Unused>};      if {[string length $attrAll] == 0} { return; };      set attrs [split {<Unused>} { }];    };    set parmList {{EvaluateExpression} {ATTR_CREATE_EXPR_PROPOGATE_MISSING_FDIV}};    foreach attr $attrs {     lappend parmList $attr;     lappend parmList {"Fel<space>vid<space>l<u00e4>sning<space>av<space>processens<space>alla<space>potentiella<space>processmodulskataloger.<space>Fel:<space><lf><at>Value<openparen>_reader_error<closeparen>"};    };    lappend parmList {StringConcatenator_4};    eval FME_Execute $parmList; }
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { StringConcatenator_4 }    INPUT  FEATURE_TYPE Aggregator_4_AGGREGATE    OUTPUT { FEATURE_TYPE StringConcatenator_4_OUTPUT         @Tcl2("StringConcatenator_4_evaluator ")          }
