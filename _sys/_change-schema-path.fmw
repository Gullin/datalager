# -------------------------------------------------------------------------
Tcl2 proc $(FileExistenceChecker_WORKSPACE_NAME)_ParameterFetcher_doFetch {} {    foreach {name val} {"FEC_FullPath {$($(FileExistenceChecker_WORKSPACE_NAME)_Input$encode)}"} {         if { [string match {*<at>*} $val] == 1 } {             set val [FME_Execute EvaluateExpression {STRING} $val {$(FileExistenceChecker_WORKSPACE_NAME)_ParameterFetcher}];         } elseif {[string match {*FME_CONDITIONAL*} $val] == 1} {             set val [FME_Execute EvaluateExpression {STRING} $val {$(FileExistenceChecker_WORKSPACE_NAME)_ParameterFetcher}];         } else {             set val [FME_DecodeTextOrAttr $val];         };       FME_SetAttribute [FME_DecodeText $name] $val    } }
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(FileExistenceChecker_WORKSPACE_NAME)_ParameterFetcher }    INPUT  FEATURE_TYPE "$(FileExistenceChecker_WORKSPACE_NAME)_Input"    OUTPUT { FEATURE_TYPE "$(FileExistenceChecker_WORKSPACE_NAME)_ParameterFetcher_OUTPUT"         @Tcl2($(FileExistenceChecker_WORKSPACE_NAME)_ParameterFetcher_doFetch)          }
