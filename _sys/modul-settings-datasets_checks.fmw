   if {{SELECTED} == {OUTGOING}} {      set attrs [list {<Unused>}];    } else {      set attrAll {_startIdx};      if {[string length $attrAll] == 0} { return; };      set attrs [split {_startIdx} { }];    };    if {{NO_OP} == {NO_OP}} {        set parmList ATTR_CREATE_EXPR_PROPAGATE_MISSING_TYPED_FDIV;    } else {        set parmList ATTR_CREATE_EXPR_PROPAGATE_MISSING_TYPED_FDIV_MULTI_FEATURE;    };    foreach attr $attrs {     lappend parmList $attr;     lappend parmList {<at>Value<openparen>_startIdx<closeparen>+1};     lappend parmList {FLOAT};    };    lappend parmList {ExpressionEvaluator_2};    if {{NO_OP} == {OTHER_NULL_VALUE_2}} {     lappend parmList {NO_OP};     lappend parmList {<Unused>};     lappend parmList {0};    };    puts "MACRO __fme_expressionevaluator_evaluateArgs__ [join $parmList ,]";
