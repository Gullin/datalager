FACTORY_DEF * TeeFactory FACTORY_NAME FeatureMerger_7_<Rejected> INPUT FEATURE_TYPE FeatureMerger_7_<REJECTED>  NO_LOGGING   OUTPUT FAILED FEATURE_TYPE * @Abort(ENCODED, FeatureMerger_7<space>output<space>a<space><lt>Rejected<gt><space>feature.<space><space>To<space>continue<space>translation<space>when<space>features<space>are<space>rejected<comma><space>change<space><apos>Workspace<space>Parameters<apos><space><gt><space>Translation<space><gt><space><apos>Rejected<space>Feature<space>Handling<apos><space>to<space><apos>Continue<space>Translation<apos>)
# -------------------------------------------------------------------------
Tcl2 proc StringConcatenator_5_evaluator {} {    if {{OUTGOING} == {OUTGOING}} {      set attr [FME_DecodeText {Logg}];      if {[string length $attr] == 0} { return; };      set attrs [list [FME_EncodeText $attr]];    } else {      set attrAll {<Unused>};      if {[string length $attrAll] == 0} { return; };      set attrs [split {<Unused>} { }];    };    set parmList {{EvaluateExpression} {ATTR_CREATE_EXPR_PROPOGATE_MISSING_FDIV}};    foreach attr $attrs {     lappend parmList $attr;     lappend parmList {"L<u00e4>sning<space>av<space>fil<space><at>Value<openparen>_FileToRead<closeparen><space>misslyckades.<lf>Felmeddelande:<lf><at>Value<openparen>_reader_error<closeparen>"};    };    lappend parmList {StringConcatenator_5};    eval FME_Execute $parmList; }
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { StringConcatenator_5 }    INPUT  FEATURE_TYPE FeatureMerger_7_MERGED    OUTPUT { FEATURE_TYPE StringConcatenator_5_OUTPUT         @Tcl2("StringConcatenator_5_evaluator ")          }
