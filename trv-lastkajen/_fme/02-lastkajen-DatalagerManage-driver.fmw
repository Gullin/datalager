DEFAULT_MACRO Aggregator_7_BREAK_ATTR
INCLUDE [if {"No" == "Yes"} {puts {MACRO Aggregator_7_BREAK_ATTR BREAK_BEFORE_FIELD_CHANGE _reader_error} }]
