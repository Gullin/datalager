FACTORY_DEF {*} TeeFactory    FACTORY_NAME { ParameterFetcher_2 }    INPUT  FEATURE_TYPE Creator_CREATED    OUTPUT { FEATURE_TYPE ParameterFetcher_2_OUTPUT         @Tcl2(ParameterFetcher_2_doFetch)          }
