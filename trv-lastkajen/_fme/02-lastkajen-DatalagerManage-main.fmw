DEFAULT_MACRO SDF3_OUT_DESTINATION_DATASETTYPE_VALIDATION_SDF3_4 Yes
SDF3_4_DESTINATION_DATASETTYPE_VALIDATION "$(SDF3_OUT_DESTINATION_DATASETTYPE_VALIDATION_SDF3_4)"
