FACTORY_DEF {*} TeeFactory    FACTORY_NAME { StringConcatenator_8 }    INPUT  FEATURE_TYPE ParameterFetcher_2_OUTPUT    OUTPUT { FEATURE_TYPE StringConcatenator_8_OUTPUT         @Tcl2("StringConcatenator_8_evaluator ")          }
