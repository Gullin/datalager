DEFAULT_MACRO SDF3_OUT_DEFAULT_SCHEMA_NAME_SDF3_4 Default
SDF3_4_DEFAULT_SCHEMA_NAME "$(SDF3_OUT_DEFAULT_SCHEMA_NAME_SDF3_4)"
GUI OPTIONAL TEXT SDF3_OUT_DEFAULT_SCHEMA_NAME_SDF3_4 Default Schema Name:
DEFAULT_MACRO SDF3_OUT_TABLE_DEFAULTS_SDF3_4 
GUI OPTIONAL DISCLOSUREGROUP SDF3_OUT_TABLE_DEFAULTS_SDF3_4 SDF3_OUT_OverwriteTable_SDF3_4%SDF3_OUT_WRITER_MODE_SDF3_4%SDF3_OUT_IdentityColumnName_SDF3_4%SDF3_OUT_GeometryColumnName_SDF3_4 Table Defaults
DEFAULT_MACRO SDF3_OUT_OverwriteTable_SDF3_4 NO
SDF3_4_OverwriteTable "$(SDF3_OUT_OverwriteTable_SDF3_4)"
GUI CHOICE SDF3_OUT_OverwriteTable_SDF3_4 YES%NO%Truncate Overwrite Table
DEFAULT_MACRO SDF3_OUT_WRITER_MODE_SDF3_4 INSERT
SDF3_4_WRITER_MODE "$(SDF3_OUT_WRITER_MODE_SDF3_4)"
GUI LOOKUP_CHOICE SDF3_OUT_WRITER_MODE_SDF3_4 Insert,INSERT%Update,UPDATE%Delete,DELETE Writer Mode
DEFAULT_MACRO SDF3_OUT_IdentityColumnName_SDF3_4 PRIMARYINDEX
SDF3_4_IdentityColumnName "$(SDF3_OUT_IdentityColumnName_SDF3_4)"
GUI OPTIONAL TEXT SDF3_OUT_IdentityColumnName_SDF3_4 Default auto-generated identity column
DEFAULT_MACRO SDF3_OUT_GeometryColumnName_SDF3_4 Geometry
SDF3_4_GeometryColumnName "$(SDF3_OUT_GeometryColumnName_SDF3_4)"
GUI OPTIONAL TEXT SDF3_OUT_GeometryColumnName_SDF3_4 Geometry Column Name
DEFAULT_MACRO SDF3_OUT_ADVANCED_SDF3_4 
