FACTORY_DEF * TeeFactory   FACTORY_NAME "AttributeCreator_12_OUTPUT Output Splitter"   INPUT FEATURE_TYPE AttributeCreator_12_OUTPUT_Output   OUTPUT FEATURE_TYPE AttributeCreator_12_OUTPUT_Output_0_4km4fXJP0og=   OUTPUT FEATURE_TYPE AttributeCreator_12_OUTPUT_Output_1_PWfcQVP8kfY=   OUTPUT FEATURE_TYPE AttributeCreator_12_OUTPUT_Output_2_4ceQX9buFZo=   OUTPUT FEATURE_TYPE AttributeCreator_12_OUTPUT_Output_3_/gGh2uBNXmA=   OUTPUT FEATURE_TYPE AttributeCreator_12_OUTPUT_Output_4_MIClaxX6W5s=   OUTPUT FEATURE_TYPE AttributeCreator_12_OUTPUT_Output_5_+XpeymL7ljE=   OUTPUT FEATURE_TYPE AttributeCreator_12_OUTPUT_Output_6_uVbFZ/008Po=
