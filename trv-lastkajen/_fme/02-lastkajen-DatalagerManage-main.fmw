 puts {DEFAULT_MACRO DestDataset_SDF3_4 $(DestDataset)}         \
 } ]
#! END_WB_HEADER
#! START_DEST_HEADER SDF3 SDF3_4
DEFAULT_MACRO DestDataset_SDF3_4 $(OutputDirectory)
GUI FILENAME DestDataset_SDF3_4 SDF_Files(*.sdf)|*.sdf|All_files(*)|* Destination Autodesk MapGuide Enterprise SDF File:
SDF3_4_EXTENT_TYPE Static
DEFAULT_MACRO SDF3_OUT_FME_GROUP_NAMED1_SDF3_4 
GUI OPTIONAL DISCLOSUREGROUP SDF3_OUT_FME_GROUP_NAMED1_SDF3_4 SDF3_OUT_OVERWRITE_FILE_SDF3_4%SDF3_OUT_DEFAULT_SCHEMA_NAME_SDF3_4 Writer Parameters
