# -------------------------------------------------------------------------
# Build the List removal function and regular expression if there was any list attributes to be removed.
# If not, then we will not have any extra list removal call to @RemoveAttributes, which speeds the
# normal, non-list removal especially when in Bulk Mode.  Note that this computation of the regular expressions is done
# once during mapping file parse time.
INCLUDE [    set listAttributeRemoveRegexps {};    set anyList {no};    foreach attr [split ""] {       set attr [FME_DecodeText $attr];       set attr [regsub "{}$" $attr "{}.*"];       set attr [regsub -all "{}" $attr "\\{\[0-9\]+\\}"];       append listAttributeRemoveRegexps ",^$attr$";       set anyList {yes};    };    if { ${anyList} == {no} } {        puts {MACRO $(SchemaManipulation_WORKSPACE_NAME)_AttributeRemover_3_LIST_FUNC }    } else {        puts "MACRO $(SchemaManipulation_WORKSPACE_NAME)_AttributeRemover_3_LIST_FUNC @RemoveAttributes(fme_pcre_match\"$listAttributeRemoveRegexps\")"    }; ]
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(SchemaManipulation_WORKSPACE_NAME)_AttributeRemover_3 }    INPUT  FEATURE_TYPE "$(SchemaManipulation_WORKSPACE_NAME)_AttributeExposer_4_OUTPUT"    OUTPUT { FEATURE_TYPE "$(SchemaManipulation_WORKSPACE_NAME)_AttributeRemover_3_OUTPUT"        @RemoveAttributes(fme_encoded,fme_schema_handling)        $($(SchemaManipulation_WORKSPACE_NAME)_AttributeRemover_3_LIST_FUNC)         }
# -------------------------------------------------------------------------
FACTORY_DEF {*} AttrSetFactory    FACTORY_NAME { $(SchemaManipulation_WORKSPACE_NAME)_AttributeCreator_45 }    COMMAND_PARM_EVALUATION SINGLE_PASS    INPUT  FEATURE_TYPE "$(SchemaManipulation_WORKSPACE_NAME)_AttributeRemover_3_OUTPUT"    MULTI_FEATURE_MODE { NO }    NULL_ATTR_MODE { NO_OP }    ATTRSET_CREATE_DIRECTIVES _PROPAGATE_MISSING_FDIV    ATTR_ACTION { "" "fme_geometry<opencurly>0<closecurly>" "SET_TO" "<at>Value<openparen>fme_type<closeparen>" }    OUTPUT { OUTPUT FEATURE_TYPE "$(SchemaManipulation_WORKSPACE_NAME)_AttributeCreator_45_OUTPUT"        }
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(SchemaManipulation_WORKSPACE_NAME)_AttributeCreator_45 OUTPUT Splitter"   INPUT FEATURE_TYPE "$(SchemaManipulation_WORKSPACE_NAME)_AttributeCreator_45_OUTPUT"   OUTPUT FEATURE_TYPE "$(SchemaManipulation_WORKSPACE_NAME)_AttributeCreator_45_OUTPUT_0_LJscjLKWsTM="   OUTPUT FEATURE_TYPE "$(SchemaManipulation_WORKSPACE_NAME)_AttributeCreator_45_OUTPUT_1_QFNnEb4wJyI="
# -------------------------------------------------------------------------
FACTORY_DEF {*} CounterFactory    FACTORY_NAME { $(SchemaManipulation_WORKSPACE_NAME)_Counter }    GROUP_BY { DatasetName }    FLUSH_WHEN_GROUPS_CHANGE { No }    START { "1" }    SCOPE { Local }    DOMAIN { "<Unused>" }    COUNT_ATTR { "gpkg_id" }    GROUP_ID_ATTR { "" }    INPUT  FEATURE_TYPE "$(SchemaManipulation_WORKSPACE_NAME)_AttributeCreator_45_OUTPUT_0_LJscjLKWsTM="    OUTPUT { OUTPUT FEATURE_TYPE "$(SchemaManipulation_WORKSPACE_NAME)_Counter_OUTPUT"        }    OUTPUT { REJECTED FEATURE_TYPE "$(SchemaManipulation_WORKSPACE_NAME)_Counter_<REJECTED>"        }
# -------------------------------------------------------------------------
FACTORY_DEF {*} AttrSetFactory    FACTORY_NAME { $(SchemaManipulation_WORKSPACE_NAME)_AttributeCreator_42 }    COMMAND_PARM_EVALUATION SINGLE_PASS    INPUT  FEATURE_TYPE "$(SchemaManipulation_WORKSPACE_NAME)_Counter_OUTPUT"    MULTI_FEATURE_MODE { NO }    NULL_ATTR_MODE { NO_OP }    ATTRSET_CREATE_DIRECTIVES _PROPAGATE_MISSING_FDIV    ATTR_ACTION { "" "name" "SET_TO" "gpkg_id" }      ATTR_ACTION { "" "fme_data_type" "SET_TO" "fme_int64<comma>PrimaryKey" }    OUTPUT { OUTPUT FEATURE_TYPE "$(SchemaManipulation_WORKSPACE_NAME)_AttributeCreator_42_OUTPUT"        }
# -------------------------------------------------------------------------
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(SchemaManipulation_WORKSPACE_NAME)_ListElementCounter }    INPUT  FEATURE_TYPE "$(SchemaManipulation_WORKSPACE_NAME)_AttributeCreator_42_OUTPUT"    OUTPUT { FEATURE_TYPE "$(SchemaManipulation_WORKSPACE_NAME)_ListElementCounter_OUTPUT"         @SupplyAttributes(ENCODED, _attribute_element_count, @NumElements("attribute<opencurly><closecurly>",ENCODED))          }
