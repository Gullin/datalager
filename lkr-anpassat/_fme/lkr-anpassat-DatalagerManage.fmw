FACTORY_DEF {*} SchemaScannerFactory    FACTORY_NAME { $(SchemaManipulation_WORKSPACE_NAME)_SchemaScanner }    COMMAND_PARM_EVALUATION SINGLE_PASS    INPUT  FEATURE_TYPE "$(SchemaManipulation_WORKSPACE_NAME)_AttributeCreator_44_OUTPUT"    GROUP_BY { DatasetName }    FLUSH_WHEN_GROUPS_CHANGE { No }    SCHEMA_FEATURES_FIRST { Yes }    SCHEMA_DEF_NAME_ATTR { "DatasetName" }    IGNORE_ATTRIBUTES_CASE_SENSITIVE { No }    COERCE_CHAR_TO_VARCHAR { Yes }    FIX_DATE_ATTRS { $(SSFACT_FIX_DATE_ATTRS) }    INFER_EMPTY_SCHEMA { $(SSFACT_INFER_EMPTY_SCHEMA) }    TEMPLATE_SCHEMA { fme_feature_type_name,varchar<openparen>200<closeparen>,DatasetName,varchar<openparen>200<closeparen> }    TYPE_OPTIONS { SCAN_USE_UNBOUNDED_STRINGS=No                   SCAN_USE_UNBOUNDED_TYPES=Yes                   SCAN_PREFER_UNSIGNED_TYPES_FOR_INTEGERS=Yes                   SCAN_FOR_DATE_ATTRIBUTES=Yes                   SCAN_FORCE_DATETIME=No                   SCAN_EMPTY_ATTRIBUTES=$(SSFACT_SCAN_EMPTY_ATTRIBUTES);                   SCAN_FOR_DATE_ATTRIBUTE_FORMAT=$(SSFACT_DATE_TIME_ATTRIBUTE_FORMAT) }    OUTPUT { SCANNED FEATURE_TYPE "$(SchemaManipulation_WORKSPACE_NAME)_SchemaScanner_Output"        }    OUTPUT { SCHEMA FEATURE_TYPE "$(SchemaManipulation_WORKSPACE_NAME)_SchemaScanner_<SCHEMA>"           }    OUTPUT { REJECTED FEATURE_TYPE "$(SchemaManipulation_WORKSPACE_NAME)_SchemaScanner_<REJECTED>"        }
DEFAULT_MACRO _WB_BYPASS_TERMINATION No
