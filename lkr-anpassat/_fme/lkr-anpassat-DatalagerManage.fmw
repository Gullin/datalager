FACTORY_DEF {*} TeeFactory    FACTORY_NAME { AttributeExposer_2 }    INPUT  FEATURE_TYPE AttributeExposer_OUTPUT_0_FFIuKLJymLk=    OUTPUT { FEATURE_TYPE AttributeExposer_2_OUTPUT          }
