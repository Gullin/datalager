FACTORY_DEF {*} ElementFactory    FACTORY_NAME { $(Fastighet_WORKSPACE_NAME)_ListExploder }    INPUT  FEATURE_TYPE "$(Fastighet_WORKSPACE_NAME)_FeatureMerger_6_MERGED"    LIST_NAME { "owners{}" }    CLONE_GEOMETRY    ATTR_ACCUM_MODE { "HANDLE_CONFLICT" }    ATTR_CONFLICT_RES { "INCOMING_IF_CONFLICT" }    INCOMING_PREFIX { "<Unused>" }    OUTPUT { ELEMENT FEATURE_TYPE "$(Fastighet_WORKSPACE_NAME)_ListExploder_ELEMENTS"         @RemoveAttributes(ElementFactory.baseCloned)          }    OUTPUT { NOLIST FEATURE_TYPE "$(Fastighet_WORKSPACE_NAME)_ListExploder_<REJECTED>"         @RemoveAttributes(ElementFactory.baseCloned)         fme_rejection_code MISSING_PARAMETER_LIST          }
