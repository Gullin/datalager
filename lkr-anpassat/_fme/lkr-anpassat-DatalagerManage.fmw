FACTORY_DEF {*} TestFactory    FACTORY_NAME { $(Fastighet_WORKSPACE_NAME)_Tester_5 }    INPUT  FEATURE_TYPE "$(Fastighet_WORKSPACE_NAME)_AttributeCreator_21_OUTPUT"    TEST { "@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>flaggnivaa<closeparen>,$(Fastighet_WORKSPACE_NAME)_Tester_5)" = 1 ENCODED } TEST { "@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>flaggnivaa<closeparen>,$(Fastighet_WORKSPACE_NAME)_Tester_5)" = 2 ENCODED }    BOOLEAN_OPERATOR { OR }    COMPOSITE_TEST_EXPR { "<Unused>" }    FEATURE_TABLE_SHIM_SUPPORT Yes    PRESERVE_FEATURE_ORDER { ACROSS_OUTPUT_PORTS }    OUTPUT { PASSED FEATURE_TYPE "$(Fastighet_WORKSPACE_NAME)_Tester_5_PASSED"         }
# -------------------------------------------------------------------------
