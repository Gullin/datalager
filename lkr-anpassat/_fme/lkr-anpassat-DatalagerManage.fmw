FACTORY_DEF * TeeFactory   FACTORY_NAME "ArcStrokerRefiner2D Input Input Collector"   INPUT FEATURE_TYPE FeatureReader_4_<OTHER>   OUTPUT FEATURE_TYPE ArcStrokerRefiner2D_Input
MACRO ArcStrokerRefiner2D_WORKSPACE_NAME ArcStrokerRefiner2D
MACRO $(ArcStrokerRefiner2D_WORKSPACE_NAME)_TRANSFORMER_GROUP 
MACRO $(ArcStrokerRefiner2D_WORKSPACE_NAME)_XFORMER_NAME ArcStrokerRefiner2D
MACRO $(ArcStrokerRefiner2D_WORKSPACE_NAME)_SUB_DOC_NAME ArcStrokerRefiner2D
MACRO $(ArcStrokerRefiner2D_WORKSPACE_NAME)_SUB_DOC_NAME ArcStrokerRefiner2D
DEFAULT_MACRO ArcStrokerRefiner2D_WORKSPACE_NAME ""
INCLUDE [puts {MACRO WB_OLD_CONTEXT_$(ArcStrokerRefiner2D_WORKSPACE_NAME) $(WB_CURRENT_CONTEXT)};          puts {MACRO WB_CURRENT_CONTEXT $(ArcStrokerRefiner2D_WORKSPACE_NAME)}]
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(ArcStrokerRefiner2D_WORKSPACE_NAME)_Input1793719345 Input Splitter"   INPUT FEATURE_TYPE "$(ArcStrokerRefiner2D_WORKSPACE_NAME)_Input"   OUTPUT FEATURE_TYPE "$(ArcStrokerRefiner2D_WORKSPACE_NAME)_Input"
# -------------------------------------------------------------------------
INCLUDE [          if { ({TOLERANCE} == {TOLERANCE}) } {             if { ({No} == {Yes}) } {                puts {MACRO $(ArcStrokerRefiner2D_WORKSPACE_NAME)_ArcStroker_func @Arc(REJECTABLE,MAX_DEVIATION, "0.02", MAKEPOLY_FOR_360ARC)};             } else {               puts {MACRO $(ArcStrokerRefiner2D_WORKSPACE_NAME)_ArcStroker_func @Arc(REJECTABLE,MAX_DEVIATION, "0.02")};             }          }          else {             if { ({No} == {Yes}) } {                puts {MACRO $(ArcStrokerRefiner2D_WORKSPACE_NAME)_ArcStroker_func @Arc(REJECTABLE,"<Unused>", MAKEPOLY_FOR_360ARC)};             } else {               puts {MACRO $(ArcStrokerRefiner2D_WORKSPACE_NAME)_ArcStroker_func @Arc(REJECTABLE,"<Unused>")};             }          }         ]
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(ArcStrokerRefiner2D_WORKSPACE_NAME)_ArcStroker_ArcStrokerInput  } 	INPUT  FEATURE_TYPE "$(ArcStrokerRefiner2D_WORKSPACE_NAME)_Input"    OUTPUT { FEATURE_TYPE ___TOARCSTROKER___  }
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(ArcStrokerRefiner2D_WORKSPACE_NAME)_ArcStroker_ArcStroker  }    INPUT FEATURE_TYPE ___TOARCSTROKER___         @RenameAttributes(FME_STRICT,___fme_rejection_code___,fme_rejection_code)    OUTPUT { FEATURE_TYPE ___TOREJECTOR___         $($(ArcStrokerRefiner2D_WORKSPACE_NAME)_ArcStroker_func) }
FACTORY_DEF {*} TestFactory    FACTORY_NAME { $(ArcStrokerRefiner2D_WORKSPACE_NAME)_ArcStroker_Rejector }    INPUT FEATURE_TYPE ___TOREJECTOR___    TEST @Value(fme_rejection_code) != ""    OUTPUT { PASSED FEATURE_TYPE "$(ArcStrokerRefiner2D_WORKSPACE_NAME)_ArcStroker_<REJECTED>"       @RemoveAttributes(___fme_rejection_code___)        }    OUTPUT { FAILED FEATURE_TYPE "$(ArcStrokerRefiner2D_WORKSPACE_NAME)_ArcStroker_STROKED"       @RenameAttributes(FME_STRICT,fme_rejection_code,___fme_rejection_code___)        }
DEFAULT_MACRO _WB_BYPASS_TERMINATION No
FACTORY_DEF * TeeFactory FACTORY_NAME "$(ArcStrokerRefiner2D_WORKSPACE_NAME)_ArcStroker_<Rejected>" INPUT FEATURE_TYPE "$(ArcStrokerRefiner2D_WORKSPACE_NAME)_ArcStroker_<REJECTED>"  NO_LOGGING   OUTPUT FAILED FEATURE_TYPE * @Abort(ENCODED, ArcStrokerRefiner2D_ArcStroker<space>output<space>a<space><lt>Rejected<gt><space>feature.<space><space>To<space>continue<space>translation<space>when<space>features<space>are<space>rejected<comma><space>change<space><apos>Workspace<space>Parameters<apos><space><gt><space>Translation<space><gt><space><apos>Rejected<space>Feature<space>Handling<apos><space>to<space><apos>Continue<space>Translation<apos>)
