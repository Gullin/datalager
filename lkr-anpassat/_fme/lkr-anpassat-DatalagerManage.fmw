FACTORY_DEF {*} ReferenceFactory    FACTORY_NAME { $(Fastighet_WORKSPACE_NAME)_FeatureMerger_7 }    FLUSH_WHEN_GROUPS_CHANGE { <Unused> }    INPUT REFERENCER FEATURE_TYPE "$(Fastighet_WORKSPACE_NAME)_TestFilter_3_SAMF"    INPUT REFERENCEE FEATURE_TYPE "$(Fastighet_WORKSPACE_NAME)_Aggregator_5_AGGREGATE_1_rhZJwySZ7LE="    REFERENCE_INFO { $($(Fastighet_WORKSPACE_NAME)_FeatureMerger_7_REFERENCE_INFO) }    REFERENCE_TABLE { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>trakt<closeparen>,$(Fastighet_WORKSPACE_NAME)_FeatureMerger_7) @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>trakt<closeparen>,$(Fastighet_WORKSPACE_NAME)_FeatureMerger_7) AUTO }    ATTR_ACCUM_MODE { "HANDLE_CONFLICT" }    ATTR_CONFLICT_RES { "SUPPLIER_IF_CONFLICT" }    IGNORE_NULLS { "No" }    HANDLE_NULL_MISSING_KEYS_LIKE_FME2013 { No }    LIST_ATTRS_TO_INCLUDE { <Unused> }    LIST_ATTRS_TO_INCLUDE_MODE { <Unused> }    MERGE_ATTRIBUTES Yes    MANAGE_FME_TYPE Yes    MODE COMPLETE    PROCESS_DUPLICATE_REFERENCEES { NO }    REFERENCEES_FIRST { No }    REJECT_INVALID_GEOM YES    CLEANING_TOLERANCE { <Unused> }    PRESERVE_FEATURE_ORDER { PER_OUTPUT_PORT }    COMPARE_WHITESPACE Yes    OUTPUT { COMPLETE FEATURE_TYPE "$(Fastighet_WORKSPACE_NAME)_FeatureMerger_7_MERGED"         }    OUTPUT { INCOMPLETE FEATURE_TYPE "$(Fastighet_WORKSPACE_NAME)_FeatureMerger_7_UNMERGED_REQUESTOR"         }    OUTPUT { REJECTED FEATURE_TYPE "$(Fastighet_WORKSPACE_NAME)_FeatureMerger_7_<REJECTED>"         }
