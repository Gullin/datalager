FACTORY_DEF {*} TestFactory    FACTORY_NAME { Tester_4 }    INPUT  FEATURE_TYPE schema_XLSXR_1    TEST { "@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>dl_export<closeparen>,Tester_4)" = true ENCODED }    BOOLEAN_OPERATOR { OR }    COMPOSITE_TEST_EXPR { "<Unused>" }    FEATURE_TABLE_SHIM_SUPPORT Yes    PRESERVE_FEATURE_ORDER { ACROSS_OUTPUT_PORTS }    OUTPUT { PASSED FEATURE_TYPE Tester_4_PASSED         }
FACTORY_DEF * TeeFactory   FACTORY_NAME "Tester_4 PASSED Splitter"   INPUT FEATURE_TYPE Tester_4_PASSED   OUTPUT FEATURE_TYPE Tester_4_PASSED_0_sOXKatJw+ig=   OUTPUT FEATURE_TYPE Tester_4_PASSED_1_ngXTKpBi1Hg=   OUTPUT FEATURE_TYPE Tester_4_PASSED_2_0o4aLEcKRwQ=
# -------------------------------------------------------------------------
FACTORY_DEF {*} TestFactory    FACTORY_NAME { Tester_2 }    INPUT  FEATURE_TYPE Tester_4_PASSED_0_sOXKatJw+ig=    TEST { "@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>dl_need_new_column_name<closeparen>,Tester_2)" = true ENCODED } TEST { "@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>dl_new_column_name<closeparen>,Tester_2)" ATTRIBUTE_HAS_VALUE "" ENCODED }    BOOLEAN_OPERATOR { COMPOSITE }    COMPOSITE_TEST_EXPR { "1 AND 2" }    FEATURE_TABLE_SHIM_SUPPORT Yes    PRESERVE_FEATURE_ORDER { ACROSS_OUTPUT_PORTS }    OUTPUT { PASSED FEATURE_TYPE Tester_2_PASSED         }
