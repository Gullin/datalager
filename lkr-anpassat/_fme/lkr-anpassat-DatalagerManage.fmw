# -------------------------------------------------------------------------
# Build the List removal function and regular expression if there was any list attributes to be removed.
# If not, then we will not have any extra list removal call to @RemoveAttributes, which speeds the
# normal, non-list removal especially when in Bulk Mode.  Note that this computation of the regular expressions is done
# once during mapping file parse time.
INCLUDE [    set listAttributeRemoveRegexps {};    set anyList {no};    foreach attr [split "dataset<opencurly><closecurly> dataset<opencurly><closecurly>.fme_dataset"] {       set attr [FME_DecodeText $attr];       set attr [regsub "{}$" $attr "{}.*"];       set attr [regsub -all "{}" $attr "\\{\[0-9\]+\\}"];       append listAttributeRemoveRegexps ",^$attr$";       set anyList {yes};    };    if { ${anyList} == {no} } {        puts {MACRO $(ConcatenatedSample_WORKSPACE_NAME)_AttributeRemover_LIST_FUNC }    } else {        puts "MACRO $(ConcatenatedSample_WORKSPACE_NAME)_AttributeRemover_LIST_FUNC @RemoveAttributes(fme_pcre_match\"$listAttributeRemoveRegexps\")"    }; ]
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(ConcatenatedSample_WORKSPACE_NAME)_AttributeRemover }    INPUT  FEATURE_TYPE "$(ConcatenatedSample_WORKSPACE_NAME)_StringConcatenator_OUTPUT_-__StringConcatenator_Output_Output"    OUTPUT { FEATURE_TYPE "$(ConcatenatedSample_WORKSPACE_NAME)_AttributeRemover_OUTPUT"        @RemoveAttributes(fme_encoded,fme_dataset,_ds1_fme_dataset,_dsn_fme_dataset,dataset<opencurly>0<closecurly>.fme_dataset,_ds0_fme_dataset)        $($(ConcatenatedSample_WORKSPACE_NAME)_AttributeRemover_LIST_FUNC)         }
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(ConcatenatedSample_WORKSPACE_NAME)_StringConcatenatedSample1746449101 Output Collector"   INPUT FEATURE_TYPE "$(ConcatenatedSample_WORKSPACE_NAME)_AttributeRemover_OUTPUT"   OUTPUT FEATURE_TYPE "$(ConcatenatedSample_WORKSPACE_NAME)_StringConcatenatedSample"
