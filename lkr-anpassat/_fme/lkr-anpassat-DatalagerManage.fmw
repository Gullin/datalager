# Consolidate the attribute merge options to what the factory expects
DEFAULT_MACRO $(Fastighet_WORKSPACE_NAME)_FeatureReader_6_COMBINE_ATTRS
INCLUDE [       if { {RESULT_ONLY} == {MERGE} } {          puts "MACRO $(Fastighet_WORKSPACE_NAME)_FeatureReader_6_COMBINE_ATTRS <Unused>";       } else {          puts "MACRO $(Fastighet_WORKSPACE_NAME)_FeatureReader_6_COMBINE_ATTRS RESULT_ONLY";       };    ]
INCLUDE [    puts {DEFAULT_MACRO FeatureReaderDataset_$(Fastighet_WORKSPACE_NAME)_FeatureReader_6 @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>Dataset<closeparen>,$(Fastighet_WORKSPACE_NAME)_FeatureReader_6)}; ]
FACTORY_DEF {*} QueryFactory    FACTORY_NAME { $(Fastighet_WORKSPACE_NAME)_FeatureReader_6 }    INPUT  FEATURE_TYPE "$(Fastighet_WORKSPACE_NAME)_TestFilter_4_dbo.off_fir_foratt_status"    $(FCTQUERY_INTERACTION_LINE)    COMBINE_ATTRIBUTES  { $($(Fastighet_WORKSPACE_NAME)_FeatureReader_6_COMBINE_ATTRS) }    IGNORE_NULLS        { <Unused> }    QUERYFCT_ATTRIBUTE_PREFIX { <Unused> }    COMBINE_GEOMETRY    { RESULT_ONLY }    ENABLE_CACHE        { NO }    QUERYFCT_TABLE_SEPARATOR { SPACE }    READER_TYPE         { MSSQL_ADO  }    READER_DATASET      { "$(FeatureReaderDataset_$(Fastighet_WORKSPACE_NAME)_FeatureReader_6)" }    QUERYFCT_IDS        { "@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>fme_feature_type_name<closeparen>,$(Fastighet_WORKSPACE_NAME)_FeatureReader_6)" }    READER_DIRECTIVES   { METAFILE,MSSQL_ADO }    QUERYFCT_OUTPUT     { "BASED_ON_CONNECTIONS" }    CONTINUE_ON_READER_ERROR YES    QUERYFCT_RESULT_TAGS { $($(Fastighet_WORKSPACE_NAME)_FeatureReader_6_OUTPUT_PORTS_ENCODED) }    QUERYFCT_SET_FME_FEATURE_TYPE YES    READER_PARAMS_WWJD     { $($(Fastighet_WORKSPACE_NAME)_FeatureReader_6_DIRECTIVES) }    TREAT_READER_PARAM_AMPERSANDS_AS_LITERALS YES    OUTPUT { RESULT FEATURE_TYPE "$(Fastighet_WORKSPACE_NAME)_FeatureReader_6_<OTHER>"           }    OUTPUT { READER_ERROR FEATURE_TYPE "$(Fastighet_WORKSPACE_NAME)_FeatureReader_6_<REJECTED>"           }
