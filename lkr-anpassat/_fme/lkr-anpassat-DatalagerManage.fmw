Tcl2 proc StringConcatenator_24_evaluator {} {    if {{OUTGOING} == {OUTGOING}} {      set attr [FME_DecodeText {cmd_copy_docs}];      if {[string length $attr] == 0} { return; };      set attrs [list [FME_EncodeText $attr]];    } else {      set attrAll {<Unused>};      if {[string length $attrAll] == 0} { return; };      set attrs [split {<Unused>} { }];    };    set parmList {{EvaluateExpression} {ATTR_CREATE_EXPR_PROPOGATE_MISSING_FDIV}};    foreach attr $attrs {     lappend parmList $attr;     lappend parmList {"ECHO<space>F<space>|<space>XCOPY<space><solidus>Q<space><solidus>I<space><solidus>Y<space><quote><at>Value<openparen>filecopy_source_dataset<closeparen><quote><space><quote><at>Value<openparen>filecopy_dest_dataset<closeparen><at>Value<openparen>filecopy_dest_filename<closeparen><quote>"};    };    lappend parmList {StringConcatenator_24};    eval FME_Execute $parmList; }
