Tcl2 proc $(ThickenThinPolygon_WORKSPACE_NAME)_ParameterFetcher_doFetch {} {    foreach {name val} {"_IsRectangle {$($(ThickenThinPolygon_WORKSPACE_NAME)_IsRectangle$encode)} _Buffer {$($(ThickenThinPolygon_WORKSPACE_NAME)_Buffer$encode)}"} {         if { [string match {*<at>*} $val] == 1 } {             set val [FME_Execute EvaluateExpression {STRING} $val {$(ThickenThinPolygon_WORKSPACE_NAME)_ParameterFetcher}];         } elseif {[string match {*FME_CONDITIONAL*} $val] == 1} {             set val [FME_Execute EvaluateExpression {STRING} $val {$(ThickenThinPolygon_WORKSPACE_NAME)_ParameterFetcher}];         } else {             set val [FME_DecodeTextOrAttr $val];         };       FME_SetAttribute [FME_DecodeText $name] $val    } }
