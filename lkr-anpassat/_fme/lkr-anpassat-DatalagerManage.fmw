# -------------------------------------------------------------------------
# First determine which function we are going to be using -- we can do
# this statically at parse time for efficiency sake
MACRO $(ThickenThinPolygon_WORKSPACE_NAME)_GeometryReplacer_SetTempAttr
MACRO $(ThickenThinPolygon_WORKSPACE_NAME)_GeometryReplacer_Function
MACRO $(ThickenThinPolygon_WORKSPACE_NAME)_GeometryReplacer_RemoveTempAttr
MACRO $(ThickenThinPolygon_WORKSPACE_NAME)_GeometryReplacer_RemoveSourceAttr
INCLUDE [ set sourceText {@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>_geometry<closeparen>,$(ThickenThinPolygon_WORKSPACE_NAME)_GeometryReplacer)};           set decodedText [FME_DecodeText "$sourceText"];           if ![regexp {@EvaluateExpression\([^)]*STRING_ENCODED,@Value\(([^()]*)\),[^()]*\)} "$decodedText" dummy geomSrcAttr] {               puts "MACRO $(ThickenThinPolygon_WORKSPACE_NAME)_GeometryReplacer_SetTempAttr @SupplyAttributes(ENCODED,__GeometryReplacerTemp__,\"$sourceText\")";               puts "MACRO $(ThickenThinPolygon_WORKSPACE_NAME)_GeometryReplacer_RemoveTempAttr @RemoveAttributes(__GeometryReplacerTemp__)";               set geomSrcAttr __GeometryReplacerTemp__;           } elseif {{No} == {Yes} } {                puts "MACRO $(ThickenThinPolygon_WORKSPACE_NAME)_GeometryReplacer_RemoveSourceAttr @RemoveAttributes(\"$geomSrcAttr\")";           };           if {{fmebinary} == {fmebinary} } {               puts "MACRO $(ThickenThinPolygon_WORKSPACE_NAME)_GeometryReplacer_Function @Geometry(FROM_ATTRIBUTE_BINARY,\"$geomSrcAttr\")";           } elseif {{fmebinary} == {fmehex} } {               puts "MACRO $(ThickenThinPolygon_WORKSPACE_NAME)_GeometryReplacer_Function @Geometry(FROM_ATTRIBUTE_BINARY_HEX,\"$geomSrcAttr\")";           } elseif {{fmebinary} == {fmexml} } {               puts "MACRO $(ThickenThinPolygon_WORKSPACE_NAME)_GeometryReplacer_Function @Geometry(FROM_ATTRIBUTE,\"$geomSrcAttr\")";           } elseif {{fmebinary} == {fmexmlencoded} } {               puts "MACRO $(ThickenThinPolygon_WORKSPACE_NAME)_GeometryReplacer_Function @Geometry(FROM_ENCODED_STRING,&\"$geomSrcAttr\")";           } elseif {{fmebinary} == {polyline} } {               puts "MACRO $(ThickenThinPolygon_WORKSPACE_NAME)_GeometryReplacer_Function @Geometry(FROM_ATTRIBUTE_POLYLINE,\"$geomSrcAttr\")";           } elseif {{fmebinary} == {wkt} } {               puts "MACRO $(ThickenThinPolygon_WORKSPACE_NAME)_GeometryReplacer_Function @OGCGeometry(from_attribute,fmebinary,\"$geomSrcAttr\",<Unused>)";           } elseif {{fmebinary} == {wkb} ||                      {fmebinary} == {wkbhex} } {               puts "MACRO $(ThickenThinPolygon_WORKSPACE_NAME)_GeometryReplacer_Function @OGCGeometry(from_attribute,fmebinary,\"$geomSrcAttr\")";           } elseif {{fmebinary} == {GEOJSON} ||                     {fmebinary} == {ESRIJSON} } {               puts "MACRO $(ThickenThinPolygon_WORKSPACE_NAME)_GeometryReplacer_Function @JSONGeometry(FROM_ATTRIBUTE,fmebinary,\"$geomSrcAttr\")";           } elseif {{fmebinary} == {GEORSS} } {               puts "MACRO $(ThickenThinPolygon_WORKSPACE_NAME)_GeometryReplacer_Function @GeoRSSGeometry(FROM_ATTRIBUTE,\"$geomSrcAttr\")";           } elseif {{fmebinary} == {KML} } {               puts "MACRO $(ThickenThinPolygon_WORKSPACE_NAME)_GeometryReplacer_Function @KMLGeometry(FROM_ATTRIBUTE,\"$geomSrcAttr\")";           } elseif {{fmebinary} == {GML} } {               puts "MACRO $(ThickenThinPolygon_WORKSPACE_NAME)_GeometryReplacer_Function @GMLGeometry(FROM_ATTRIBUTE,\"$geomSrcAttr\",<Unused>)";           } elseif {{fmebinary} == {geohash} } {               puts "MACRO $(ThickenThinPolygon_WORKSPACE_NAME)_GeometryReplacer_Function @GeoHash(FROM_ATTRIBUTE,\"$geomSrcAttr\",<Unused>)";           } elseif {{fmebinary} == {ogeosms} ||                     {fmebinary} == {geosms}  ||                     {fmebinary} == {geo} } {               puts "MACRO $(ThickenThinPolygon_WORKSPACE_NAME)_GeometryReplacer_Function @OGCGeometry(from_attribute,fmebinary,\"$geomSrcAttr\")";           } elseif {{fmebinary} == {mgrs}} {               puts "MACRO $(ThickenThinPolygon_WORKSPACE_NAME)_GeometryReplacer_Function @MGRS(FROM_MGRS, <Unused>, <Unused>,\"@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>_geometry<closeparen>,$(ThickenThinPolygon_WORKSPACE_NAME)_GeometryReplacer)\")"           } elseif {{fmebinary} == {mssql} } {               puts "MACRO $(ThickenThinPolygon_WORKSPACE_NAME)_GeometryReplacer_Function @SerializeGeometry(from_attribute,fmebinary,\"$geomSrcAttr\",<Unused>)";           } elseif {{fmebinary} == {iso6709} } {               puts "MACRO $(ThickenThinPolygon_WORKSPACE_NAME)_GeometryReplacer_Function @GeographicPoint(FROM_ATTRIBUTE,\"$geomSrcAttr\")";           } elseif {{fmebinary} == {qlikmaps} } {               puts "MACRO $(ThickenThinPolygon_WORKSPACE_NAME)_GeometryReplacer_Function @Geometry(FROM_ATTRIBUTE_QLIKMAPS_POLYLINE,\"$geomSrcAttr\")";           }; ]
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(ThickenThinPolygon_WORKSPACE_NAME)_GeometryReplacer }    INPUT  FEATURE_TYPE "$(ThickenThinPolygon_WORKSPACE_NAME)_Tester_4_FAILED"    OUTPUT { FEATURE_TYPE ___TOREJECTOR___         @RenameAttributes(FME_STRICT,___fme_rejection_code___,fme_rejection_code)         $($(ThickenThinPolygon_WORKSPACE_NAME)_GeometryReplacer_SetTempAttr)         $($(ThickenThinPolygon_WORKSPACE_NAME)_GeometryReplacer_Function)         $($(ThickenThinPolygon_WORKSPACE_NAME)_GeometryReplacer_RemoveTempAttr) }
