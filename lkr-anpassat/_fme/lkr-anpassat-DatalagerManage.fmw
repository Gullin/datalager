FACTORY_DEF {*} AggregateFactory    FACTORY_NAME { $(SearchBoundingBoxAndPoint_WORKSPACE_NAME)_Aggregator_4 }    INPUT  FEATURE_TYPE "$(SearchBoundingBoxAndPoint_WORKSPACE_NAME)_Bufferer_BUFFERED"    INPUT  FEATURE_TYPE "$(SearchBoundingBoxAndPoint_WORKSPACE_NAME)_TestFilter_5_area_1_ZXM+SzxLn6w="    INPUT  FEATURE_TYPE "$(SearchBoundingBoxAndPoint_WORKSPACE_NAME)_TestFilter_5_line_1_HCDua2ut/3g="    MODE { ONE_LEVEL }    GROUP_BY { $($(SearchBoundingBoxAndPoint_WORKSPACE_NAME)_ATTRIBUTES) }    FLUSH_WHEN_GROUPS_CHANGE { No }    REMOVE_GEOMETRY { NO }    ACCUMULATE_ATTRIBUTES { One }    LIST_ATTRS_TO_INCLUDE { <Unused> }    LIST_ATTRS_TO_INCLUDE_MODE { <Unused> }    SEPARATOR { <comma> }    PRODUCE_MULTIS { YES }    OUTPUT { AGGREGATE FEATURE_TYPE "$(SearchBoundingBoxAndPoint_WORKSPACE_NAME)_Aggregator_4_AGGREGATE"          }
