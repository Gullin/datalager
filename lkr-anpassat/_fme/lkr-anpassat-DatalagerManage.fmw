Tcl2 proc $(SearchBoundingBoxAndPoint_WORKSPACE_NAME)_StringConcatenator_evaluator {} {    if {{OUTGOING} == {OUTGOING}} {      set attr [FME_DecodeText {error_msg}];      if {[string length $attr] == 0} { return; };      set attrs [list [FME_EncodeText $attr]];    } else {      set attrAll {<Unused>};      if {[string length $attrAll] == 0} { return; };      set attrs [split {<Unused>} { }];    };    set parmList {{EvaluateExpression} {ATTR_CREATE_EXPR_PROPOGATE_MISSING_FDIV}};    foreach attr $attrs {     lappend parmList $attr;     lappend parmList {"F<u00f6>ljande<space>fme_type<space><apos><at>Value<openparen>fme_type<closeparen><apos><space>hanterades<space>inte<space>men<space>f<u00f6>rekom.<space>St<u00e4>llningstagande<space>kr<u00e4>vs."};    };    lappend parmList {$(SearchBoundingBoxAndPoint_WORKSPACE_NAME)_StringConcatenator};    eval FME_Execute $parmList; }
