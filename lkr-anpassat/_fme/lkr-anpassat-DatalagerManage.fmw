FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(Fastighet_WORKSPACE_NAME)_TestFilter_INPUT }    INPUT  FEATURE_TYPE "$(Fastighet_WORKSPACE_NAME)_StringConcatenator_2_OUTPUT"    INPUT  FEATURE_TYPE "$(Fastighet_WORKSPACE_NAME)_Tester_7_FAILED"    OUTPUT FEATURE_TYPE $(Fastighet_WORKSPACE_NAME)_TestFilter_INPUTLINE
FACTORY_DEF {*} TestFactory FACTORY_NAME { $(Fastighet_WORKSPACE_NAME)_TestFilter } INPUT FEATURE_TYPE $(Fastighet_WORKSPACE_NAME)_TestFilter_INPUTLINE FEATURE_TABLE_SHIM_SUPPORT Yes PRESERVE_FEATURE_ORDER ACROSS_OUTPUT_PORTS PASSED_TEST_GROUP_OUTPUT FIRST TEST_GROUP TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>FORVTYP<closeparen>,$(Fastighet_WORKSPACE_NAME)_TestFilter) = L ENCODED } BOOLEAN_OPERATOR OR COMPOSITE_TEST_EXPR <Unused> OUTPUT PASSED_0 FEATURE_TYPE $(Fastighet_WORKSPACE_NAME)_TestFilter_<at>Value<openparen>FORVTYP<closeparen><space>=<space>L TEST_GROUP TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>FORVTYP<closeparen>,$(Fastighet_WORKSPACE_NAME)_TestFilter) = T ENCODED } BOOLEAN_OPERATOR OR COMPOSITE_TEST_EXPR <Unused> OUTPUT PASSED_1 FEATURE_TYPE $(Fastighet_WORKSPACE_NAME)_TestFilter_<at>Value<openparen>FORVTYP<closeparen><space>=<space>T OUTPUT FAILED FEATURE_TYPE $(Fastighet_WORKSPACE_NAME)_TestFilter_<lt>UNFILTERED<gt>
