Tcl2 proc $(Search_WORKSPACE_NAME)_StringConcatenator_36_evaluator {} {    if {{OUTGOING} == {OUTGOING}} {      set attr [FME_DecodeText {typ}];      if {[string length $attr] == 0} { return; };      set attrs [list [FME_EncodeText $attr]];    } else {      set attrAll {<Unused>};      if {[string length $attrAll] == 0} { return; };      set attrs [split {<Unused>} { }];    };    set parmList {{EvaluateExpression} {ATTR_CREATE_EXPR_PROPOGATE_MISSING_FDIV}};    foreach attr $attrs {     lappend parmList $attr;     lappend parmList {"adressomr<u00e5>de<space><at>Value<openparen>bal_typ<closeparen>"};    };    lappend parmList {$(Search_WORKSPACE_NAME)_StringConcatenator_36};    eval FME_Execute $parmList; }
