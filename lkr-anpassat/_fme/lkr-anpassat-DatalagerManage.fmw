# -------------------------------------------------------------------------
# Since the Tcl "END" index specification starts at -1 for the second
# last character, and we've defined -1 to be the last charater, we've got
# small bit of fiddling to do
Tcl2 proc $(Fastighet_WORKSPACE_NAME)_SubstringExtractor_2_fixLastIndex {lastValue} {     if {$lastValue < -1} {         incr lastValue;         return "end$lastValue";     }     elseif {$lastValue == -1} {         return "end";     }     else {         return $lastValue;     } }
Tcl2 proc $(Fastighet_WORKSPACE_NAME)_SubstringExtractor_2_extract {startIdx endIdx} {     FME_SetAttribute [FME_DecodeText _substring]         [string range [FME_DecodeTextOrAttr @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>fastighet<closeparen>,$(Fastighet_WORKSPACE_NAME)_SubstringExtractor_2)]                       [$(Fastighet_WORKSPACE_NAME)_SubstringExtractor_2_fixLastIndex $startIdx]                       [$(Fastighet_WORKSPACE_NAME)_SubstringExtractor_2_fixLastIndex $endIdx]]     }
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(Fastighet_WORKSPACE_NAME)_SubstringExtractor_2 }    INPUT  FEATURE_TYPE "$(Fastighet_WORKSPACE_NAME)_FeatureMerger_4_MERGED"    INPUT  FEATURE_TYPE "$(Fastighet_WORKSPACE_NAME)_FeatureMerger_4_UNMERGED_REQUESTOR"    OUTPUT { FEATURE_TYPE "$(Fastighet_WORKSPACE_NAME)_SubstringExtractor_2_OUTPUT"         @Tcl2("$(Fastighet_WORKSPACE_NAME)_SubstringExtractor_2_extract 5 -1")          }
# -------------------------------------------------------------------------
# Since the Tcl "END" index specification starts at -1 for the second
# last character, and we've defined -1 to be the last charater, we've got
# small bit of fiddling to do
Tcl2 proc $(Fastighet_WORKSPACE_NAME)_SubstringExtractor_3_fixLastIndex {lastValue} {     if {$lastValue < -1} {         incr lastValue;         return "end$lastValue";     }     elseif {$lastValue == -1} {         return "end";     }     else {         return $lastValue;     } }
Tcl2 proc $(Fastighet_WORKSPACE_NAME)_SubstringExtractor_3_extract {startIdx endIdx} {     FME_SetAttribute [FME_DecodeText namn]         [string range [FME_DecodeTextOrAttr @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>_substring<closeparen>,$(Fastighet_WORKSPACE_NAME)_SubstringExtractor_3)]                       [$(Fastighet_WORKSPACE_NAME)_SubstringExtractor_3_fixLastIndex $startIdx]                       [$(Fastighet_WORKSPACE_NAME)_SubstringExtractor_3_fixLastIndex $endIdx]]     }
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(Fastighet_WORKSPACE_NAME)_SubstringExtractor_3 }    INPUT  FEATURE_TYPE "$(Fastighet_WORKSPACE_NAME)_SubstringExtractor_2_OUTPUT"    OUTPUT { FEATURE_TYPE "$(Fastighet_WORKSPACE_NAME)_SubstringExtractor_3_OUTPUT"         @Tcl2("$(Fastighet_WORKSPACE_NAME)_SubstringExtractor_3_extract 0 @EvaluateExpression(FDIV,FLOAT,<at>FindString<openparen><at>Value<openparen>_substring<closeparen><comma><quote>:<quote><closeparen>-1,$(Fastighet_WORKSPACE_NAME)_SubstringExtractor_3)")          }
