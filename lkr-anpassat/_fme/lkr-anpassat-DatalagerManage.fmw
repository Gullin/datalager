MACRO $(Fastighet_WORKSPACE_NAME)_FeatureReader_6_DIRECTIVES CREATE_FEATURE_TABLES_FROM_DATA,Yes,NAMED_CONNECTION,<lt>at<gt>Value<lt>openparen<gt>Dataset<lt>closeparen<gt>,APPLICATION_INTENT,ReadWrite,READ_CACHE_SIZE,10,QUERY_FEATURE_TYPES_FOR_MERGE_FILTERS,Yes,COMMAND_TIMEOUT,30
