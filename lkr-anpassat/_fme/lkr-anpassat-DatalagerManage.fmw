Tcl2 proc StringConcatenator_28_evaluator {} {    if {{OUTGOING} == {OUTGOING}} {      set attr [FME_DecodeText {DatasetName}];      if {[string length $attr] == 0} { return; };      set attrs [list [FME_EncodeText $attr]];    } else {      set attrAll {<Unused>};      if {[string length $attrAll] == 0} { return; };      set attrs [split {<Unused>} { }];    };    set parmList {{EvaluateExpression} {ATTR_CREATE_EXPR_PROPOGATE_MISSING_FDIV}};    foreach attr $attrs {     lappend parmList $attr;     lappend parmList {"<at>Value<openparen>fme_feature_type<closeparen><at>Value<openparen>_name_extension<closeparen>_y"};    };    lappend parmList {StringConcatenator_28};    eval FME_Execute $parmList; }
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { StringConcatenator_28 }    INPUT  FEATURE_TYPE AttributeCreator_28_OUTPUT    OUTPUT { FEATURE_TYPE StringConcatenator_28_OUTPUT         @Tcl2("StringConcatenator_28_evaluator ")          }
