FACTORY_DEF {*} TestFactory FACTORY_NAME { $(Plan_och_Tomt_WORKSPACE_NAME)_TestFilter_3 } INPUT FEATURE_TYPE $(Plan_och_Tomt_WORKSPACE_NAME)_TestFilter_3_INPUTLINE FEATURE_TABLE_SHIM_SUPPORT Yes PRESERVE_FEATURE_ORDER ACROSS_OUTPUT_PORTS PASSED_TEST_GROUP_OUTPUT FIRST TEST_GROUP TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>_filterValue<closeparen>,$(Plan_och_Tomt_WORKSPACE_NAME)_TestFilter_3) = td_drk.rk_plan_y ENCODED } BOOLEAN_OPERATOR OR COMPOSITE_TEST_EXPR "1" OUTPUT PASSED_0 FEATURE_TYPE $(Plan_och_Tomt_WORKSPACE_NAME)_TestFilter_3_td_drk.rk_plan_y TEST_GROUP TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>_filterValue<closeparen>,$(Plan_och_Tomt_WORKSPACE_NAME)_TestFilter_3) = td_drk.rk_plan_y_info ENCODED } BOOLEAN_OPERATOR OR COMPOSITE_TEST_EXPR "1" OUTPUT PASSED_1 FEATURE_TYPE $(Plan_och_Tomt_WORKSPACE_NAME)_TestFilter_3_td_drk.rk_plan_y_info TEST_GROUP TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>_filterValue<closeparen>,$(Plan_och_Tomt_WORKSPACE_NAME)_TestFilter_3) = dbo.fir_plan ENCODED } BOOLEAN_OPERATOR OR COMPOSITE_TEST_EXPR "1" OUTPUT PASSED_2 FEATURE_TYPE $(Plan_och_Tomt_WORKSPACE_NAME)_TestFilter_3_dbo.fir_plan TEST_GROUP TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>_filterValue<closeparen>,$(Plan_och_Tomt_WORKSPACE_NAME)_TestFilter_3) = dbo.fir_plan_beslut ENCODED } BOOLEAN_OPERATOR OR COMPOSITE_TEST_EXPR "1" OUTPUT PASSED_3 FEATURE_TYPE $(Plan_och_Tomt_WORKSPACE_NAME)_TestFilter_3_dbo.fir_plan_beslut TEST_GROUP TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>_filterValue<closeparen>,$(Plan_och_Tomt_WORKSPACE_NAME)_TestFilter_3) = dbo.fir_plan_egnauppg ENCODED } BOOLEAN_OPERATOR OR COMPOSITE_TEST_EXPR "1" OUTPUT PASSED_4 FEATURE_TYPE $(Plan_och_Tomt_WORKSPACE_NAME)_TestFilter_3_dbo.fir_plan_egnauppg TEST_GROUP TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>_filterValue<closeparen>,$(Plan_och_Tomt_WORKSPACE_NAME)_TestFilter_3) = dbo.fir_firkoder ENCODED } BOOLEAN_OPERATOR OR COMPOSITE_TEST_EXPR "1" OUTPUT PASSED_5 FEATURE_TYPE $(Plan_och_Tomt_WORKSPACE_NAME)_TestFilter_3_dbo.fir_firkoder TEST_GROUP TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>_filterValue<closeparen>,$(Plan_och_Tomt_WORKSPACE_NAME)_TestFilter_3) = dbo.fir_plan_kommun ENCODED } BOOLEAN_OPERATOR OR COMPOSITE_TEST_EXPR "1" OUTPUT PASSED_6 FEATURE_TYPE $(Plan_och_Tomt_WORKSPACE_NAME)_TestFilter_3_dbo.fir_plan_kommun TEST_GROUP TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>_filterValue<closeparen>,$(Plan_och_Tomt_WORKSPACE_NAME)_TestFilter_3) = dbo.fir_plan_hanvisn ENCODED } BOOLEAN_OPERATOR OR COMPOSITE_TEST_EXPR "1" OUTPUT PASSED_7 FEATURE_TYPE $(Plan_och_Tomt_WORKSPACE_NAME)_TestFilter_3_dbo.fir_plan_hanvisn TEST_GROUP TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>_filterValue<closeparen>,$(Plan_och_Tomt_WORKSPACE_NAME)_TestFilter_3) = dbo.fir_plan_hanvtext ENCODED } BOOLEAN_OPERATOR OR COMPOSITE_TEST_EXPR "1" OUTPUT PASSED_8 FEATURE_TYPE $(Plan_och_Tomt_WORKSPACE_NAME)_TestFilter_3_dbo.fir_plan_hanvtext OUTPUT FAILED FEATURE_TYPE $(Plan_och_Tomt_WORKSPACE_NAME)_TestFilter_3_<lt>UNFILTERED<gt>
