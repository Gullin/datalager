FACTORY_DEF {*} TestFactory    FACTORY_NAME { $(Fastighet_WORKSPACE_NAME)_Tester_7 }    INPUT  FEATURE_TYPE "$(Fastighet_WORKSPACE_NAME)_StringCaseChanger_OUTPUT"    TEST { "@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>FORNAMN<closeparen>,$(Fastighet_WORKSPACE_NAME)_Tester_7)" ATTRIBUTE_HAS_VALUE "" ENCODED }    BOOLEAN_OPERATOR { OR }    COMPOSITE_TEST_EXPR { "<Unused>" }    FEATURE_TABLE_SHIM_SUPPORT Yes    PRESERVE_FEATURE_ORDER { ACROSS_OUTPUT_PORTS }    OUTPUT { PASSED FEATURE_TYPE "$(Fastighet_WORKSPACE_NAME)_Tester_7_PASSED"         }    OUTPUT { FAILED FEATURE_TYPE "$(Fastighet_WORKSPACE_NAME)_Tester_7_FAILED"         }
# -------------------------------------------------------------------------
Tcl2 proc $(Fastighet_WORKSPACE_NAME)_StringConcatenator_2_evaluator {} {    if {{SELECTED} == {OUTGOING}} {      set attr [FME_DecodeText {<Unused>}];      if {[string length $attr] == 0} { return; };      set attrs [list [FME_EncodeText $attr]];    } else {      set attrAll {NAMN};      if {[string length $attrAll] == 0} { return; };      set attrs [split {NAMN} { }];    };    set parmList {{EvaluateExpression} {ATTR_CREATE_EXPR_PROPOGATE_MISSING_FDIV}};    foreach attr $attrs {     lappend parmList $attr;     lappend parmList {"<at>Value<openparen>EFTERNAMN<closeparen><comma><space><at>Value<openparen>FORNAMN<closeparen>"};    };    lappend parmList {$(Fastighet_WORKSPACE_NAME)_StringConcatenator_2};    eval FME_Execute $parmList; }
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(Fastighet_WORKSPACE_NAME)_StringConcatenator_2 }    INPUT  FEATURE_TYPE "$(Fastighet_WORKSPACE_NAME)_Tester_7_PASSED"    OUTPUT { FEATURE_TYPE "$(Fastighet_WORKSPACE_NAME)_StringConcatenator_2_OUTPUT"         @Tcl2("$(Fastighet_WORKSPACE_NAME)_StringConcatenator_2_evaluator ")          }
# -------------------------------------------------------------------------
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(Fastighet_WORKSPACE_NAME)_TestFilter_INPUT }    INPUT  FEATURE_TYPE "$(Fastighet_WORKSPACE_NAME)_StringConcatenator_2_OUTPUT"    INPUT  FEATURE_TYPE "$(Fastighet_WORKSPACE_NAME)_Tester_7_FAILED"    OUTPUT FEATURE_TYPE $(Fastighet_WORKSPACE_NAME)_TestFilter_INPUTLINE
FACTORY_DEF {*} TestFactory FACTORY_NAME { $(Fastighet_WORKSPACE_NAME)_TestFilter } INPUT FEATURE_TYPE $(Fastighet_WORKSPACE_NAME)_TestFilter_INPUTLINE FEATURE_TABLE_SHIM_SUPPORT Yes PRESERVE_FEATURE_ORDER ACROSS_OUTPUT_PORTS PASSED_TEST_GROUP_OUTPUT FIRST TEST_GROUP TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>FORVTYP<closeparen>,$(Fastighet_WORKSPACE_NAME)_TestFilter) = L ENCODED } BOOLEAN_OPERATOR OR COMPOSITE_TEST_EXPR <Unused> OUTPUT PASSED_0 FEATURE_TYPE $(Fastighet_WORKSPACE_NAME)_TestFilter_<at>Value<openparen>FORVTYP<closeparen><space>=<space>L TEST_GROUP TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>FORVTYP<closeparen>,$(Fastighet_WORKSPACE_NAME)_TestFilter) = T ENCODED } BOOLEAN_OPERATOR OR COMPOSITE_TEST_EXPR <Unused> OUTPUT PASSED_1 FEATURE_TYPE $(Fastighet_WORKSPACE_NAME)_TestFilter_<at>Value<openparen>FORVTYP<closeparen><space>=<space>T OUTPUT FAILED FEATURE_TYPE $(Fastighet_WORKSPACE_NAME)_TestFilter_<lt>UNFILTERED<gt>
