FACTORY_DEF {*} TestFactory FACTORY_NAME { $(Fastighet_WORKSPACE_NAME)_TestFilter_4 } INPUT FEATURE_TYPE $(Fastighet_WORKSPACE_NAME)_TestFilter_4_INPUTLINE FEATURE_TABLE_SHIM_SUPPORT Yes PRESERVE_FEATURE_ORDER ACROSS_OUTPUT_PORTS PASSED_TEST_GROUP_OUTPUT FIRST TEST_GROUP TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>_filterValue<closeparen>,$(Fastighet_WORKSPACE_NAME)_TestFilter_4) = td_drk.rk_fastighet_y ENCODED } BOOLEAN_OPERATOR OR COMPOSITE_TEST_EXPR "1" OUTPUT PASSED_0 FEATURE_TYPE $(Fastighet_WORKSPACE_NAME)_TestFilter_4_td_drk.rk_fastighet_y TEST_GROUP TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>_filterValue<closeparen>,$(Fastighet_WORKSPACE_NAME)_TestFilter_4) = dbo.fir_fastigh ENCODED } BOOLEAN_OPERATOR OR COMPOSITE_TEST_EXPR "1" OUTPUT PASSED_1 FEATURE_TYPE $(Fastighet_WORKSPACE_NAME)_TestFilter_4_dbo.fir_fastigh TEST_GROUP TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>_filterValue<closeparen>,$(Fastighet_WORKSPACE_NAME)_TestFilter_4) = dbo.fir_foratt_status ENCODED } BOOLEAN_OPERATOR OR COMPOSITE_TEST_EXPR "1" OUTPUT PASSED_2 FEATURE_TYPE $(Fastighet_WORKSPACE_NAME)_TestFilter_4_dbo.fir_foratt_status TEST_GROUP TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>_filterValue<closeparen>,$(Fastighet_WORKSPACE_NAME)_TestFilter_4) = dbo.fb_fir_lagfart ENCODED } BOOLEAN_OPERATOR OR COMPOSITE_TEST_EXPR "1" OUTPUT PASSED_3 FEATURE_TYPE $(Fastighet_WORKSPACE_NAME)_TestFilter_4_dbo.fb_fir_lagfart TEST_GROUP TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>_filterValue<closeparen>,$(Fastighet_WORKSPACE_NAME)_TestFilter_4) = dbo.tax_taxpers ENCODED } BOOLEAN_OPERATOR OR COMPOSITE_TEST_EXPR "1" OUTPUT PASSED_4 FEATURE_TYPE $(Fastighet_WORKSPACE_NAME)_TestFilter_4_dbo.tax_taxpers OUTPUT FAILED FEATURE_TYPE $(Fastighet_WORKSPACE_NAME)_TestFilter_4_<lt>UNFILTERED<gt>
