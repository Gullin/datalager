# check if we have to do the min bounding box calculation
INCLUDE [    if { {BB} == {MINBB} } {       puts {MACRO $(SearchBoundingBoxAndPoint_WORKSPACE_NAME)_BoundingBoxReplacer_BBFunc @Force2D() @Bounds(MIN_BOUNDING,,,<Unused>)};    } elseif { {BB} == {BB} } {       puts {MACRO $(SearchBoundingBoxAndPoint_WORKSPACE_NAME)_BoundingBoxReplacer_BBFunc @Force2D() @Bounds(BOUNDING_BOX_AXIS_ALIGNED,,)};    } else {       puts {MACRO $(SearchBoundingBoxAndPoint_WORKSPACE_NAME)_BoundingBoxReplacer_BBFunc @Bounds(BOUNDING_CUBE,,)};    } ]
