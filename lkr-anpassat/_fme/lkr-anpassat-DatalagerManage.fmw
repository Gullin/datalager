# -------------------------------------------------------------------------
FACTORY_DEF {*} AttrSetFactory    FACTORY_NAME { AttributeCreator_24 }    COMMAND_PARM_EVALUATION SINGLE_PASS    INPUT  FEATURE_TYPE AttributeCreator_23_OUTPUT    MULTI_FEATURE_MODE { NO }    NULL_ATTR_MODE { NO_OP }    ATTRSET_CREATE_DIRECTIVES _PROPAGATE_MISSING_FDIV    ATTR_ACTION { "" "_name_extension" "SET_TO" "_belagenhetsadress" }    OUTPUT { OUTPUT FEATURE_TYPE AttributeCreator_24_OUTPUT        }
# -------------------------------------------------------------------------
Tcl2 proc StringConcatenator_23_evaluator {} {    if {{OUTGOING} == {OUTGOING}} {      set attr [FME_DecodeText {DatasetName}];      if {[string length $attr] == 0} { return; };      set attrs [list [FME_EncodeText $attr]];    } else {      set attrAll {<Unused>};      if {[string length $attrAll] == 0} { return; };      set attrs [split {<Unused>} { }];    };    set parmList {{EvaluateExpression} {ATTR_CREATE_EXPR_PROPOGATE_MISSING_FDIV}};    foreach attr $attrs {     lappend parmList $attr;     lappend parmList {"<at>Value<openparen>fme_feature_type<closeparen><at>Value<openparen>_name_extension<closeparen>_p"};    };    lappend parmList {StringConcatenator_23};    eval FME_Execute $parmList; }
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { StringConcatenator_23 }    INPUT  FEATURE_TYPE AttributeCreator_24_OUTPUT    OUTPUT { FEATURE_TYPE StringConcatenator_23_OUTPUT         @Tcl2("StringConcatenator_23_evaluator ")          }
# -------------------------------------------------------------------------
FACTORY_DEF {*} AttrSetFactory    COMMAND_PARM_EVALUATION SINGLE_PASS    FACTORY_NAME { AttributeManager }    INPUT  FEATURE_TYPE StringConcatenator_23_OUTPUT    MULTI_FEATURE_MODE { NO }    NULL_ATTR_MODE { NO_OP }    ATTRSET_CREATE_DIRECTIVES _PROPAGATE_MISSING_FDIV    ACTION_COLUMN 3    DEF_VAL_COLUMN 2    MISSING_INPUT_ATTR_HANDLING RENAME_SET_VALUE REMOVE    ATTR_ACTION { "bal_objektidentitet" "objid" "" "RENAME_SET_VALUE" }      ATTR_ACTION { "bal_nummer" "nr" "" "RENAME_SET_VALUE" }      ATTR_ACTION { "bal_bokstavstillagg" "littera" "" "RENAME_SET_VALUE" }      ATTR_ACTION { "bal_lagestillagg" "lagtillagg" "" "RENAME_SET_VALUE" }      ATTR_ACTION { "bal_tillaggsnummer" "tillaggnr" "" "RENAME_SET_VALUE" }      ATTR_ACTION { "bal_typ" "typ" "" "RENAME_SET_VALUE" }      ATTR_ACTION { "bal_insamlingslage" "insamlage" "" "RENAME_SET_VALUE" }      ATTR_ACTION { "bal_belagenhetsstatus" "belstatus" "" "RENAME_SET_VALUE" }      ATTR_ACTION { "bal_objektstatus" "objstatus" "" "RENAME_SET_VALUE" }      ATTR_ACTION { "bal_postnummer" "postnr" "" "RENAME_SET_VALUE" }      ATTR_ACTION { "bal_postort" "postort" "" "RENAME_SET_VALUE" }      ATTR_ACTION { "bal_namn" "namn" "" "RENAME_SET_VALUE" }      ATTR_ACTION { "td_adressomradesnamn" "adromr" "" "RENAME_SET_VALUE" }      ATTR_ACTION { "td_gardsadressomradesnamn" "gardadromr" "" "RENAME_SET_VALUE" }      ATTR_ACTION { "td_adress" "adress" "" "RENAME_SET_VALUE" }      ATTR_ACTION { "td_gardsadress" "gardadress" "" "RENAME_SET_VALUE" }      ATTR_ACTION { "td_nummer_bokstav" "nr_littera" "" "RENAME_SET_VALUE" }      ATTR_ACTION { "_name_extension" "_name_extension" "" "REMOVE" }      ATTR_ACTION { "fme_feature_type_name" "fme_feature_type_name" "" "REMOVE" }      ATTR_ACTION { "fme_feature_type" "fme_feature_type" "" "REMOVE" }    OUTPUT { OUTPUT FEATURE_TYPE AttributeManager_OUTPUT        }
