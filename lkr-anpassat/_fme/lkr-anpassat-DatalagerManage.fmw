Tcl2 proc StringConcatenator_36_evaluator {} {    if {{OUTGOING} == {OUTGOING}} {      set attr [FME_DecodeText {DatasetName}];      if {[string length $attr] == 0} { return; };      set attrs [list [FME_EncodeText $attr]];    } else {      set attrAll {<Unused>};      if {[string length $attrAll] == 0} { return; };      set attrs [split {<Unused>} { }];    };    set parmList {{EvaluateExpression} {ATTR_CREATE_EXPR_PROPOGATE_MISSING_FDIV}};    foreach attr $attrs {     lappend parmList $attr;     lappend parmList {"<at>Value<openparen>_name<closeparen><at>Value<openparen>_name_extension<closeparen>"};    };    lappend parmList {StringConcatenator_36};    eval FME_Execute $parmList; }
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { StringConcatenator_36 }    INPUT  FEATURE_TYPE Search_Output    OUTPUT { FEATURE_TYPE StringConcatenator_36_OUTPUT         @Tcl2("StringConcatenator_36_evaluator ")          }
