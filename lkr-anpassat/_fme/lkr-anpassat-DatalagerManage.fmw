# -------------------------------------------------------------------------
# 20210313 - Use Macros to engage/disengage the solid vs. 2d buffering rather than a runtime
# check to reduce processing overhead
INCLUDE [if { ("JOIN_ARC" == "JOIN_MITER") } {         } else {             puts "MACRO MITER_TO_USE 0"         };         if { ("AREA" == "SOLID") } {             puts "MACRO SOLIDFACTORYENGAGED *";             puts "MACRO DISSOLVEFACTORYENGAGED NO";         } else {             puts "MACRO SOLIDFACTORYENGAGED NO";             puts "MACRO DISSOLVEFACTORYENGAGED *";         };         ]
#
# This is the AREA part of the buffering:
#
FACTORY_DEF {$(DISSOLVEFACTORYENGAGED)} PolygonDissolveFactory    FACTORY_NAME { $(SearchBoundingBoxAndPoint_WORKSPACE_NAME)_Bufferer_2DBuffering }    INPUT  FEATURE_TYPE "$(SearchBoundingBoxAndPoint_WORKSPACE_NAME)_TestFilter_5_point_0_LDVzn8HVyok="    FLUSH_WHEN_GROUPS_CHANGE { No }    REJECT_INVALID_GEOM Yes    USE_AZMED_NEIGHBORHOOD Yes    PRE_BUFFER { "1" "22.5" "CAP_ARC" "JOIN_ARC" "$(MITER_TO_USE)" FULL OFFSET_UNITS "NONE" PRECISION "APPROX" }    DISSOLVE_MODE GEOS    CLEANING_TOLERANCE { AUTO }    LIST_ATTRS_TO_INCLUDE { <Unused> }    LIST_ATTRS_TO_INCLUDE_MODE { <Unused> }    OUTPUT { POLYGON FEATURE_TYPE "$(SearchBoundingBoxAndPoint_WORKSPACE_NAME)_Bufferer_BUFFERED"         }    OUTPUT { NON_POLYGON FEATURE_TYPE "$(SearchBoundingBoxAndPoint_WORKSPACE_NAME)_Bufferer_BUFFERED"         }    OUTPUT { REJECTED FEATURE_TYPE "$(SearchBoundingBoxAndPoint_WORKSPACE_NAME)_Bufferer_<REJECTED>"         }
#
# This is the SOLID part of the buffering:
#
FACTORY_DEF {$(SOLIDFACTORYENGAGED)} SolidBufferingFactory    FACTORY_NAME { $(SearchBoundingBoxAndPoint_WORKSPACE_NAME)_Bufferer_3DBuffering }    INPUT  FEATURE_TYPE "$(SearchBoundingBoxAndPoint_WORKSPACE_NAME)_TestFilter_5_point_0_LDVzn8HVyok="    SPHERE_RADIUS { "1" }    SPHERE_DIVISIONS { "<Unused>" }    OUTPUT { BUFFERED FEATURE_TYPE "$(SearchBoundingBoxAndPoint_WORKSPACE_NAME)_Bufferer_BUFFERED"        }    OUTPUT { <REJECTED> FEATURE_TYPE "$(SearchBoundingBoxAndPoint_WORKSPACE_NAME)_Bufferer_<REJECTED>"        }
