E)_TestFilter_3) = dbo.fir_firkoder ENCODED } BOOLEAN_OPERATOR OR COMPOSITE_TEST_EXPR "1" OUTPUT PASSED_5 FEATURE_TYPE $(Plan_och_Tomt_WORKSPACE_NAME)_TestFilter_3_dbo.fir_firkoder TEST_GROUP TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>_filterValue<closeparen>,$(Plan_och_Tomt_WORKSPACE_NAME)_TestFilter_3) = dbo.off_fir_plan_kommun ENCODED } BOOLEAN_OPERATOR OR COMPOSITE_TEST_EXPR "1" OUTPUT PASSED_6 FEATURE_TYPE $(Plan_och_Tomt_WORKSPACE_NAME)_TestFilter_3_dbo.off_fir_plan_kommun TEST_GROUP TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>_filterValue<closeparen>,$(Plan_och_Tomt_WORKSPACE_NAME)_TestFilter_3) = dbo.off_fir_plan_hanvisn ENCODED } BOOLEAN_OPERATOR OR COMPOSITE_TEST_EXPR "1" OUTPUT PASSED_7 FEATURE_TYPE $(Plan_och_Tomt_WORKSPACE_NAME)_TestFilter_3_dbo.off_fir_plan_hanvisn TEST_GROUP TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>_filterValue<closeparen>,$(Plan_och_Tomt_WORKSPACE_NAME)_TestFilter_3) = dbo.off_fir_plan_hanvtext ENCODED } BOOLEAN_OPERATOR OR COMPOSITE_TEST_EXPR "1" OUTPUT PASSED_8 FEATURE_TYPE $(Plan_och_Tomt_WORKSPACE_NAME)_TestFilter_3_dbo.off_fir_plan_hanvtext OUTPUT FAILED FEATURE_TYPE $(Plan_och_Tomt_WORKSPACE_NAME)_TestFilter_3_<lt>UNFILTERED<gt>
