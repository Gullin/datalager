Tcl2 proc StringConcatenator_37_evaluator {} {    if {{OUTGOING} == {OUTGOING}} {      set attr [FME_DecodeText {Logg}];      if {[string length $attr] == 0} { return; };      set attrs [list [FME_EncodeText $attr]];    } else {      set attrAll {<Unused>};      if {[string length $attrAll] == 0} { return; };      set attrs [split {<Unused>} { }];    };    set parmList {{EvaluateExpression} {ATTR_CREATE_EXPR_PROPOGATE_MISSING_FDIV}};    foreach attr $attrs {     lappend parmList $attr;     lappend parmList {"Platsnamn<space>kunde<space>ej<space>behandlas<space>korrekt.<space>Fel:<space><at>Value<openparen>fme_rejection_code<closeparen><at>Value<openparen>_reader_error<closeparen>"};    };    lappend parmList {StringConcatenator_37};    eval FME_Execute $parmList; }
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { StringConcatenator_37 }    INPUT  FEATURE_TYPE FeatureMerger_10_MERGED    OUTPUT { FEATURE_TYPE StringConcatenator_37_OUTPUT         @Tcl2("StringConcatenator_37_evaluator ")          }
