Tcl2 proc $(Fastighet_WORKSPACE_NAME)_Creator_CoordSysRemover {} {   global FME_CoordSys;   set FME_CoordSys {}; }
MACRO $(Fastighet_WORKSPACE_NAME)_Creator_XML     NOT_ACTIVATED
MACRO $(Fastighet_WORKSPACE_NAME)_Creator_CLASSIC NOT_ACTIVATED
MACRO $(Fastighet_WORKSPACE_NAME)_Creator_2D3D    2D_GEOMETRY
MACRO $(Fastighet_WORKSPACE_NAME)_Creator_COORDS  <Unused>
INCLUDE [ if { {Geometry Object} == {Geometry Object} } {            puts {MACRO $(Fastighet_WORKSPACE_NAME)_Creator_XML *} } ]
INCLUDE [ if { {Geometry Object} == {2D Coordinate List} } {            puts {MACRO $(Fastighet_WORKSPACE_NAME)_Creator_2D3D 2D_GEOMETRY};            puts {MACRO $(Fastighet_WORKSPACE_NAME)_Creator_CLASSIC *} } ]
INCLUDE [ if { {Geometry Object} == {3D Coordinate List} } {            puts {MACRO $(Fastighet_WORKSPACE_NAME)_Creator_2D3D 3D_GEOMETRY};            puts {MACRO $(Fastighet_WORKSPACE_NAME)_Creator_CLASSIC *} } ]
INCLUDE [ if { {Geometry Object} == {2D Min/Max Box} } {            set comment {                We need to turn the COORDS which are                    minX minY maxX maxY                into a full polygon list of coordinates            };            set splitCoords [split [string trim {<Unused>}]];            if { [llength $splitCoords] > 4} {               set trimmedCoords {};               foreach item $splitCoords { if { $item != {} } {lappend trimmedCoords $item} };               set splitCoords $trimmedCoords;            };            if { [llength $splitCoords] != 4 } {                error {$(Fastighet_WORKSPACE_NAME)_Creator: Coordinate list is expected to be a space delimited list of four numbers as 'minx miny maxx maxy' - `<Unused>' is invalid};            };            set minX [lindex $splitCoords 0];            set minY [lindex $splitCoords 1];            set maxX [lindex $splitCoords 2];            set maxY [lindex $splitCoords 3];            puts "MACRO $(Fastighet_WORKSPACE_NAME)_Creator_COORDS $minX $minY $minX $maxY $maxX $maxY $maxX $minY $minX $minY";            puts {MACRO $(Fastighet_WORKSPACE_NAME)_Creator_2D3D 2D_GEOMETRY};            puts {MACRO $(Fastighet_WORKSPACE_NAME)_Creator_CLASSIC *} } ]
FACTORY_DEF {$($(Fastighet_WORKSPACE_NAME)_Creator_XML)} CreationFactory    FACTORY_NAME { $(Fastighet_WORKSPACE_NAME)_Creator_XML_Creator }    CREATE_AT_END { no }    OUTPUT { FEATURE_TYPE _____CREATED______        @Geometry(FROM_ENCODED_STRING,<lt>?xml<space>version=<quote>1.0<quote><space>encoding=<quote>US_ASCII<quote><space>standalone=<quote>no<quote><space>?<gt><lt>geometry<gt><lt>null<solidus><gt><lt><solidus>geometry<gt>) }
FACTORY_DEF {$($(Fastighet_WORKSPACE_NAME)_Creator_CLASSIC)} CreationFactory    FACTORY_NAME { $(Fastighet_WORKSPACE_NAME)_Creator_CLASSIC_Creator }    $($(Fastighet_WORKSPACE_NAME)_Creator_2D3D) { $($(Fastighet_WORKSPACE_NAME)_Creator_COORDS) }    CREATE_AT_END { no }    OUTPUT { FEATURE_TYPE _____CREATED______ }
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(Fastighet_WORKSPACE_NAME)_Creator_Cloner }    INPUT FEATURE_TYPE _____CREATED______        @Tcl2($(Fastighet_WORKSPACE_NAME)_Creator_CoordSysRemover)        @CoordSys()    NUMBER_OF_COPIES { 1 }    OUTPUT { FEATURE_TYPE "$(Fastighet_WORKSPACE_NAME)_Creator_CREATED"        fme_feature_type $(Fastighet_WORKSPACE_NAME)_Creator         }
