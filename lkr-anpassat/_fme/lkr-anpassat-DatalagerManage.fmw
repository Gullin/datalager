# -------------------------------------------------------------------------
MACRO $(Fastighet_WORKSPACE_NAME)_FeatureReader_9_OUTPUT_PORTS_ENCODED 
MACRO $(Fastighet_WORKSPACE_NAME)_FeatureReader_9_DIRECTIVES CREATE_FEATURE_TABLES_FROM_DATA,Yes,NAMED_CONNECTION,<lt>at<gt>Value<lt>openparen<gt>Dataset<lt>closeparen<gt>,APPLICATION_INTENT,ReadWrite,READ_CACHE_SIZE,10,QUERY_FEATURE_TYPES_FOR_MERGE_FILTERS,Yes,COMMAND_TIMEOUT,30
# Always provide an INTERACTION, otherwise the factory defaults to ENVELOPE_INTERSECTS
INCLUDE [if { ( {<Unused>} == {<Unused>} ) || ( {($INTERACT)} == {} ) } {             puts {MACRO FCTQUERY_INTERACTION_LINE FCTQUERY_INTERACTION NONE};          } else {             puts {MACRO FCTQUERY_INTERACTION_LINE FCTQUERY_INTERACTION "<Unused>"};          }         ]
# Consolidate the attribute merge options to what the factory expects
DEFAULT_MACRO $(Fastighet_WORKSPACE_NAME)_FeatureReader_9_COMBINE_ATTRS
INCLUDE [       if { {RESULT_ONLY} == {MERGE} } {          puts "MACRO $(Fastighet_WORKSPACE_NAME)_FeatureReader_9_COMBINE_ATTRS <Unused>";       } else {          puts "MACRO $(Fastighet_WORKSPACE_NAME)_FeatureReader_9_COMBINE_ATTRS RESULT_ONLY";       };    ]
INCLUDE [    puts {DEFAULT_MACRO FeatureReaderDataset_$(Fastighet_WORKSPACE_NAME)_FeatureReader_9 @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>Dataset<closeparen>,$(Fastighet_WORKSPACE_NAME)_FeatureReader_9)}; ]
FACTORY_DEF {*} QueryFactory    FACTORY_NAME { $(Fastighet_WORKSPACE_NAME)_FeatureReader_9 }    INPUT  FEATURE_TYPE "$(Fastighet_WORKSPACE_NAME)_TestFilter_4_dbo.tax_taxpers"    $(FCTQUERY_INTERACTION_LINE)    COMBINE_ATTRIBUTES  { $($(Fastighet_WORKSPACE_NAME)_FeatureReader_9_COMBINE_ATTRS) }    IGNORE_NULLS        { <Unused> }    QUERYFCT_ATTRIBUTE_PREFIX { <Unused> }    COMBINE_GEOMETRY    { RESULT_ONLY }    ENABLE_CACHE        { NO }    QUERYFCT_TABLE_SEPARATOR { SPACE }    READER_TYPE         { MSSQL_ADO  }    READER_DATASET      { "$(FeatureReaderDataset_$(Fastighet_WORKSPACE_NAME)_FeatureReader_9)" }    QUERYFCT_IDS        { "@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>fme_feature_type_name<closeparen>,$(Fastighet_WORKSPACE_NAME)_FeatureReader_9)" }    READER_DIRECTIVES   { METAFILE,MSSQL_ADO }    QUERYFCT_OUTPUT     { "BASED_ON_CONNECTIONS" }    CONTINUE_ON_READER_ERROR YES    QUERYFCT_RESULT_TAGS { $($(Fastighet_WORKSPACE_NAME)_FeatureReader_9_OUTPUT_PORTS_ENCODED) }    QUERYFCT_SET_FME_FEATURE_TYPE YES    READER_PARAMS_WWJD     { $($(Fastighet_WORKSPACE_NAME)_FeatureReader_9_DIRECTIVES) }    TREAT_READER_PARAM_AMPERSANDS_AS_LITERALS YES    OUTPUT { RESULT FEATURE_TYPE "$(Fastighet_WORKSPACE_NAME)_FeatureReader_9_<OTHER>"           }    OUTPUT { READER_ERROR FEATURE_TYPE "$(Fastighet_WORKSPACE_NAME)_FeatureReader_9_<REJECTED>"           }
