FACTORY_DEF {*} TestFactory    FACTORY_NAME { $(Fastighet_WORKSPACE_NAME)_Tester_2 }    INPUT  FEATURE_TYPE "$(Fastighet_WORKSPACE_NAME)_AttributeExposer_2_OUTPUT_0_Kqp8ryjxbo8="    TEST { "@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>l_ponr<closeparen>,$(Fastighet_WORKSPACE_NAME)_Tester_2)" = 16212000-1140 ENCODED } TEST { l_ponr ATTRIBUTE_VALUE_NULL "" ENCODED } TEST { l_ponr ATTRIBUTE_IS_MISSING "" ENCODED } TEST { "@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>tx_ponr<closeparen>,$(Fastighet_WORKSPACE_NAME)_Tester_2)" = 16212000-1140 ENCODED }    BOOLEAN_OPERATOR { COMPOSITE }    COMPOSITE_TEST_EXPR { "1 OR (( 2 OR 3 ) AND 4 )" }    FEATURE_TABLE_SHIM_SUPPORT Yes    PRESERVE_FEATURE_ORDER { ACROSS_OUTPUT_PORTS }    OUTPUT { PASSED FEATURE_TYPE "$(Fastighet_WORKSPACE_NAME)_Tester_2_PASSED"         }
