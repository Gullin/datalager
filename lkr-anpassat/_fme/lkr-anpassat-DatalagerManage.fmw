# 20210313 - Use Macros to engage/disengage the solid vs. 2d buffering rather than a runtime
# check to reduce processing overhead
INCLUDE [if { ("JOIN_ARC" == "JOIN_MITER") } {         } else {             puts "MACRO MITER_TO_USE 0"         };         if { ("AREA" == "SOLID") } {             puts "MACRO SOLIDFACTORYENGAGED *";             puts "MACRO DISSOLVEFACTORYENGAGED NO";         } else {             puts "MACRO SOLIDFACTORYENGAGED NO";             puts "MACRO DISSOLVEFACTORYENGAGED *";         };         ]
#
# This is the AREA part of the buffering:
#
FACTORY_DEF {$(DISSOLVEFACTORYENGAGED)} PolygonDissolveFactory    FACTORY_NAME { $(ThickenThinPolygon_WORKSPACE_NAME)_Bufferer_3_2DBuffering }    INPUT  FEATURE_TYPE "$(ThickenThinPolygon_WORKSPACE_NAME)_Tester_3_PASSED"    FLUSH_WHEN_GROUPS_CHANGE { No }    REJECT_INVALID_GEOM Yes    USE_AZMED_NEIGHBORHOOD Yes    PRE_BUFFER { "@EvaluateExpression(FDIV,FLOAT,<at>Value<openparen>_Buffer<closeparen>-<at>Value<openparen>_sideLength_A<closeparen>,$(ThickenThinPolygon_WORKSPACE_NAME)_Bufferer_3)" "22.5" "CAP_ARC" "JOIN_ARC" "$(MITER_TO_USE)" FULL OFFSET_UNITS "NONE" PRECISION "APPROX" }    DISSOLVE_MODE GEOS    CLEANING_TOLERANCE { AUTO }    LIST_ATTRS_TO_INCLUDE { <Unused> }    LIST_ATTRS_TO_INCLUDE_MODE { <Unused> }    OUTPUT { POLYGON FEATURE_TYPE "$(ThickenThinPolygon_WORKSPACE_NAME)_Bufferer_3_BUFFERED"         }    OUTPUT { NON_POLYGON FEATURE_TYPE "$(ThickenThinPolygon_WORKSPACE_NAME)_Bufferer_3_BUFFERED"         }    OUTPUT { REJECTED FEATURE_TYPE "$(ThickenThinPolygon_WORKSPACE_NAME)_Bufferer_3_<REJECTED>"         }
