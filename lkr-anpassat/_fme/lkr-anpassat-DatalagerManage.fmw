FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(Fastighet_WORKSPACE_NAME)_AttributeExposer_8 }    INPUT  FEATURE_TYPE "$(Fastighet_WORKSPACE_NAME)_FeatureReader_9_<OTHER>"    OUTPUT { FEATURE_TYPE "$(Fastighet_WORKSPACE_NAME)_AttributeExposer_8_OUTPUT"          }
# -------------------------------------------------------------------------
FACTORY_DEF {*} AttrSetFactory    COMMAND_PARM_EVALUATION SINGLE_PASS    FACTORY_NAME { $(Fastighet_WORKSPACE_NAME)_AttributeRenamer_4 }    INPUT  FEATURE_TYPE "$(Fastighet_WORKSPACE_NAME)_AttributeExposer_8_OUTPUT" 	ATTRSET_CREATE_DIRECTIVES _PROPAGATE_MISSING_FDIV    MISSING_INPUT_ATTR_HANDLING RENAME_SET_DEFAULT PRESERVE 	ATTR_ACTION { "PERSORGNR" "TAX_PERSORGNR" "RENAME_SET_DEFAULT" "" }    OUTPUT { OUTPUT FEATURE_TYPE "$(Fastighet_WORKSPACE_NAME)_AttributeRenamer_4_OUTPUT"        }
# -------------------------------------------------------------------------
DEFAULT_MACRO $(Fastighet_WORKSPACE_NAME)_DateTimeStamper_EXPRESSION
INCLUDE [    set expression {<at>DateTimeCast<openparen><at>DateTimeNow<openparen>local<closeparen><comma>date<closeparen>};    if { "<Unused>" eq "NO" } {        set expression <at>TimeZoneRemove<openparen>$expression<closeparen>;    };    puts "MACRO $(Fastighet_WORKSPACE_NAME)_DateTimeStamper_EXPRESSION $expression"; ]
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(Fastighet_WORKSPACE_NAME)_DateTimeStamper }    INPUT  FEATURE_TYPE "$(Fastighet_WORKSPACE_NAME)_AttributeRenamer_4_OUTPUT"    OUTPUT { FEATURE_TYPE "$(Fastighet_WORKSPACE_NAME)_DateTimeStamper_OUTPUT"       @EvaluateExpression(ATTR_CREATE_EXPR_PROPAGATE_MISSING_FDIV, _datestamp, $($(Fastighet_WORKSPACE_NAME)_DateTimeStamper_EXPRESSION), $(Fastighet_WORKSPACE_NAME)_DateTimeStamper)        }
# -------------------------------------------------------------------------
# Since the Tcl "END" index specification starts at -1 for the second
# last character, and we've defined -1 to be the last charater, we've got
# small bit of fiddling to do
Tcl2 proc $(Fastighet_WORKSPACE_NAME)_SubstringExtractor_fixLastIndex {lastValue} {     if {$lastValue < -1} {         incr lastValue;         return "end$lastValue";     }     elseif {$lastValue == -1} {         return "end";     }     else {         return $lastValue;     } }
Tcl2 proc $(Fastighet_WORKSPACE_NAME)_SubstringExtractor_extract {startIdx endIdx} {     FME_SetAttribute [FME_DecodeText _yearstamp]         [string range [FME_DecodeTextOrAttr @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>_datestamp<closeparen>,$(Fastighet_WORKSPACE_NAME)_SubstringExtractor)]                       [$(Fastighet_WORKSPACE_NAME)_SubstringExtractor_fixLastIndex $startIdx]                       [$(Fastighet_WORKSPACE_NAME)_SubstringExtractor_fixLastIndex $endIdx]]     }
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(Fastighet_WORKSPACE_NAME)_SubstringExtractor }    INPUT  FEATURE_TYPE "$(Fastighet_WORKSPACE_NAME)_DateTimeStamper_OUTPUT"    OUTPUT { FEATURE_TYPE "$(Fastighet_WORKSPACE_NAME)_SubstringExtractor_OUTPUT"         @Tcl2("$(Fastighet_WORKSPACE_NAME)_SubstringExtractor_extract 0 3")          }
# -------------------------------------------------------------------------
INCLUDE TCL
   if {{OUTGOING} == {OUTGOING}} {      set attrs [list {_yearstampbefore}];    } else {      set attrAll {<Unused>};      if {[string length $attrAll] == 0} { return; };      set attrs [split {<Unused>} { }];    };    if {{NO_OP} == {NO_OP}} {        set parmList ATTR_CREATE_EXPR_PROPAGATE_MISSING_TYPED_FDIV;    } else {        set parmList ATTR_CREATE_EXPR_PROPAGATE_MISSING_TYPED_FDIV_MULTI_FEATURE;    };    foreach attr $attrs {     lappend parmList $attr;     lappend parmList {<at>Value<openparen>_yearstamp<closeparen>-1};     lappend parmList {FLOAT};    };    lappend parmList {$(Fastighet_WORKSPACE_NAME)_ExpressionEvaluator};    if {{NO_OP} == {OTHER_NULL_VALUE_2}} {     lappend parmList {NO_OP};     lappend parmList {<Unused>};     lappend parmList {0};    };    puts "MACRO __fme_expressionevaluator_evaluateArgs__ [join $parmList ,]";
END_INCLUDE
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(Fastighet_WORKSPACE_NAME)_ExpressionEvaluator }    INPUT  FEATURE_TYPE "$(Fastighet_WORKSPACE_NAME)_SubstringExtractor_OUTPUT"    OUTPUT { FEATURE_TYPE "$(Fastighet_WORKSPACE_NAME)_ExpressionEvaluator_OUTPUT"         @EvaluateExpression($(__fme_expressionevaluator_evaluateArgs__))          }
MACRO __fme_expressionevaluator_evaluateArgs__
# -------------------------------------------------------------------------
FACTORY_DEF {*} TestFactory    FACTORY_NAME { $(Fastighet_WORKSPACE_NAME)_Tester_9 }    INPUT  FEATURE_TYPE "$(Fastighet_WORKSPACE_NAME)_ExpressionEvaluator_OUTPUT"    TEST { "@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>taxar<closeparen>,$(Fastighet_WORKSPACE_NAME)_Tester_9)" >= "@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>_yearstampbefore<closeparen>,$(Fastighet_WORKSPACE_NAME)_Tester_9)" ENCODED }    BOOLEAN_OPERATOR { OR }    COMPOSITE_TEST_EXPR { "<Unused>" }    FEATURE_TABLE_SHIM_SUPPORT Yes    PRESERVE_FEATURE_ORDER { ACROSS_OUTPUT_PORTS }    OUTPUT { PASSED FEATURE_TYPE "$(Fastighet_WORKSPACE_NAME)_Tester_9_PASSED"         }
# -------------------------------------------------------------------------
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(Fastighet_WORKSPACE_NAME)_TestFilter_2_INPUT }    INPUT  FEATURE_TYPE "$(Fastighet_WORKSPACE_NAME)_Tester_9_PASSED"    OUTPUT FEATURE_TYPE $(Fastighet_WORKSPACE_NAME)_TestFilter_2_INPUTLINE
FACTORY_DEF {*} TestFactory FACTORY_NAME { $(Fastighet_WORKSPACE_NAME)_TestFilter_2 } INPUT FEATURE_TYPE $(Fastighet_WORKSPACE_NAME)_TestFilter_2_INPUTLINE FEATURE_TABLE_SHIM_SUPPORT Yes PRESERVE_FEATURE_ORDER ACROSS_OUTPUT_PORTS PASSED_TEST_GROUP_OUTPUT FIRST TEST_GROUP TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>taxar<closeparen>,$(Fastighet_WORKSPACE_NAME)_TestFilter_2) = @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>_yearstamp<closeparen>,$(Fastighet_WORKSPACE_NAME)_TestFilter_2) ENCODED } BOOLEAN_OPERATOR AND COMPOSITE_TEST_EXPR "1" OUTPUT PASSED_0 FEATURE_TYPE $(Fastighet_WORKSPACE_NAME)_TestFilter_2_<at>Value<openparen>taxar<closeparen><space>=<space><at>Value<openparen>_yearstamp<closeparen> TEST_GROUP TEST { @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>taxar<closeparen>,$(Fastighet_WORKSPACE_NAME)_TestFilter_2) = @EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>_yearstampbefore<closeparen>,$(Fastighet_WORKSPACE_NAME)_TestFilter_2) ENCODED } BOOLEAN_OPERATOR AND COMPOSITE_TEST_EXPR "1" OUTPUT PASSED_1 FEATURE_TYPE $(Fastighet_WORKSPACE_NAME)_TestFilter_2_<at>Value<openparen>taxar<closeparen><space>=<space><at>Value<openparen>_yearstampbefore<closeparen> OUTPUT FAILED FEATURE_TYPE $(Fastighet_WORKSPACE_NAME)_TestFilter_2_<lt>UNFILTERED<gt>
