INCLUDE [    if { {ALL} == {EXCEPT} } {       puts {MACRO $(Fastighet_WORKSPACE_NAME)_Matcher_ATTRMATCH MATCH_ALL_ATTRS_EXCEPT { <Unused> } };    }    elseif { {ALL} == {ALL} } {       puts {MACRO $(Fastighet_WORKSPACE_NAME)_Matcher_ATTRMATCH MATCH_ALL_ATTRIBUTES};    }    elseif { {ALL} == {MATCH} } {       puts {MACRO $(Fastighet_WORKSPACE_NAME)_Matcher_ATTRMATCH MATCH_ATTRIBUTES { <Unused> } };    }    else {       puts {MACRO $(Fastighet_WORKSPACE_NAME)_Matcher_ATTRMATCH MATCH_ATTRIBUTES};    } ]
FACTORY_DEF {*} MatchingFactory    FACTORY_NAME { $(Fastighet_WORKSPACE_NAME)_Matcher }    INPUT  FEATURE_TYPE "$(Fastighet_WORKSPACE_NAME)_Tester_2_PASSED"    MATCH_GEOMETRY { 2D }    $($(Fastighet_WORKSPACE_NAME)_Matcher_ATTRMATCH)    BLANK_AND_MISSING_DIFFER { No }    BLANK_AND_MISSING_NAMES_TRAITS_DIFFER { <Unused> }    CHECK_TYPES_AND_ENCODINGS { No }    VECTOR_TOLERANCE { 0 }    LENIENT_GEOMETRY_MATCH { No }    CHECK_COORDINATE_SYSTEMS { No }    ADD_TO_MATCHED { _match_id }    LIST_ATTRS_TO_INCLUDE { <Unused> }    LIST_ATTRS_TO_INCLUDE_MODE { <Unused> }    OUTPUT { SINGLE_MATCHED FEATURE_TYPE "$(Fastighet_WORKSPACE_NAME)_Matcher_SINGLE_MATCHED"          }    OUTPUT { NOT_MATCHED FEATURE_TYPE "$(Fastighet_WORKSPACE_NAME)_Matcher_NOT_MATCHED"          }
# -------------------------------------------------------------------------
# Build the List removal function and regular expression if there was any list attributes to be removed.
# If not, then we will not have any extra list removal call to @RemoveAttributes, which speeds the
# normal, non-list removal especially when in Bulk Mode.  Note that this computation of the regular expressions is done
# once during mapping file parse time.
INCLUDE [    set listAttributeRemoveRegexps {};    set anyList {no};    foreach attr [split ""] {       set attr [FME_DecodeText $attr];       set attr [regsub "{}$" $attr "{}.*"];       set attr [regsub -all "{}" $attr "\\{\[0-9\]+\\}"];       append listAttributeRemoveRegexps ",^$attr$";       set anyList {yes};    };    if { ${anyList} == {no} } {        puts {MACRO $(Fastighet_WORKSPACE_NAME)_AttributeRemover_3_LIST_FUNC }    } else {        puts "MACRO $(Fastighet_WORKSPACE_NAME)_AttributeRemover_3_LIST_FUNC @RemoveAttributes(fme_pcre_match\"$listAttributeRemoveRegexps\")"    }; ]
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(Fastighet_WORKSPACE_NAME)_AttributeRemover_3 }    INPUT  FEATURE_TYPE "$(Fastighet_WORKSPACE_NAME)_Matcher_SINGLE_MATCHED"    INPUT  FEATURE_TYPE "$(Fastighet_WORKSPACE_NAME)_Matcher_NOT_MATCHED"    OUTPUT { FEATURE_TYPE "$(Fastighet_WORKSPACE_NAME)_AttributeRemover_3_OUTPUT"        @RemoveAttributes(fme_encoded,_match_id)        $($(Fastighet_WORKSPACE_NAME)_AttributeRemover_3_LIST_FUNC)         }
