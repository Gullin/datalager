Tcl2 proc StringConcatenator_10_evaluator {} {    if {{SELECTED} == {OUTGOING}} {      set attr [FME_DecodeText {<Unused>}];      if {[string length $attr] == 0} { return; };      set attrs [list [FME_EncodeText $attr]];    } else {      set attrAll {_dirpath};      if {[string length $attrAll] == 0} { return; };      set attrs [split {_dirpath} { }];    };    set parmList {{EvaluateExpression} {ATTR_CREATE_EXPR_PROPOGATE_MISSING_FDIV}};    foreach attr $attrs {     lappend parmList $attr;     lappend parmList {"<at>Value<openparen>_dirpath<closeparen><at>Value<openparen>DatasetFull<closeparen>"};    };    lappend parmList {StringConcatenator_10};    eval FME_Execute $parmList; }
