Tcl2 proc Logg_6_9d1727a9_6583_4992_99b4_e7b27cde3a836_summarizer { } {     global Logg_6_9d1727a9_6583_4992_99b4_e7b27cde3a836_process_count;     set comment { incr 0 creates the variable if it wasn't present };     incr Logg_6_9d1727a9_6583_4992_99b4_e7b27cde3a836_process_count 0;     FME_SetAttribute _proc_count [set Logg_6_9d1727a9_6583_4992_99b4_e7b27cde3a836_process_count];     global Logg_6_9d1727a9_6583_4992_99b4_e7b27cde3a836_all_processes;     if {[info exists Logg_6_9d1727a9_6583_4992_99b4_e7b27cde3a836_all_processes]} {         set index 0;         foreach pid [set Logg_6_9d1727a9_6583_4992_99b4_e7b27cde3a836_all_processes] {             FME_SetAttribute \"_processes{$index}\" $pid;             incr index;         }     } }
