Tcl2 proc Logg_3_a2dc5150_8b22_4522_8b61_8966a350848e6_summarizer { } {     global Logg_3_a2dc5150_8b22_4522_8b61_8966a350848e6_process_count;     set comment { incr 0 creates the variable if it wasn't present };     incr Logg_3_a2dc5150_8b22_4522_8b61_8966a350848e6_process_count 0;     FME_SetAttribute _proc_count [set Logg_3_a2dc5150_8b22_4522_8b61_8966a350848e6_process_count];     global Logg_3_a2dc5150_8b22_4522_8b61_8966a350848e6_all_processes;     if {[info exists Logg_3_a2dc5150_8b22_4522_8b61_8966a350848e6_all_processes]} {         set index 0;         foreach pid [set Logg_3_a2dc5150_8b22_4522_8b61_8966a350848e6_all_processes] {             FME_SetAttribute \"_processes{$index}\" $pid;             incr index;         }     } }
