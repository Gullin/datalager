Tcl2 proc StringConcatenator_4_evaluator {} {    if {{OUTGOING} == {OUTGOING}} {      set attr [FME_DecodeText {Logg}];      if {[string length $attr] == 0} { return; };      set attrs [list [FME_EncodeText $attr]];    } else {      set attrAll {<Unused>};      if {[string length $attrAll] == 0} { return; };      set attrs [split {<Unused>} { }];    };    set parmList {{EvaluateExpression} {ATTR_CREATE_EXPR_PROPOGATE_MISSING_FDIV}};    foreach attr $attrs {     lappend parmList $attr;     lappend parmList {"F<u00f6>ljande<space><at>Value<openparen>Antal<closeparen><space><space>st.<space>format<space>st<u00f6>ds<space>ej<space><openparen><at>Value<openparen>fme_format_short_name<closeparen><closeparen>.<space>F<u00f6>r<space>att<space>export<space>ska<space>vara<space>fullt<space>m<u00f6>jligt<space>enligt<space>manifest<comma><space><u00e4>ndra<space>i<space>manifest<space>eller<space>definiera<space>ny<space>WorkspaceRunner<space>med<space>workspace."};    };    lappend parmList {StringConcatenator_4};    eval FME_Execute $parmList; }
