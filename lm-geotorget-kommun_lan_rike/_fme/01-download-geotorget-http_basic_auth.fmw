#!   NAME="LantmaterietAPIAccessTokenFetcher"
#!   ARCGIS_COMPATIBILITY=""
#!   CATEGORY="Web"
#!   DESCRIPTION="&lt;h1&gt;LantmaterietAPIAccessTokenFetcher&lt;/h1&gt;&#10;&lt;p&gt;Generates an Access Token for API:s from Lantmäteriet, the Swedish mapping, cadastral and land registration authority.&lt;/p&gt;&#10;&lt;p&gt;If the token received expires too soon, it is revoked and a new token is generated.&lt;/p&gt;&#10;&lt;p&gt;This transformer can be used on its own to generate authentication for Lantmäteriet&apos;s API:s.&lt;/p&gt;&#10;&lt;p&gt;It can also be used together with the following transformers to handle downloads from the &quot;Geotorget-Order - v2&quot; API:&lt;/p&gt;&#10;&lt;ul&gt;&#10;&lt;li&gt;&lt;a href=&quot;https://hub.safe.com/publishers/mattias/transformers/lantmaterietapideliveryrequestor&quot;&gt;LantmaterietAPIDeliveryRequestor&lt;/a&gt;&lt;/li&gt;&#10;&lt;li&gt;&lt;a href=&quot;https://hub.safe.com/publishers/mattias/transformers/lantmaterietapidownloadlinkfetcher&quot;&gt;LantmaterietAPIDownloadLinkFetcher&lt;/a&gt;&lt;/li&gt;&#10;&lt;/ul&gt;"
#!   DOC_DYNAMIC_INPUT_ATTRS="0"
#!   DOC_EXTENTS="8055.2 3271.48"
#!   DOC_TOP_LEFT="-3812.61 -959.502"
#!   FME_DOCUMENT_GUID=""
#!   FME_DOCUMENT_PRIORGUID="f2b43e79-224f-4386-bc59-1033c5c2c9e9,6f533bbe-26d4-43fc-90fd-1b4e36f0c66f,e7799fc5-0ff0-47b7-905d-958380879239,480371da-bf62-42f6-ba3c-52d99869ff37,49661b87-4036-47f5-a449-06deb372ab1e,940e295e-4856-4694-a052-5a99af836336,fd874299-39b2-4f8a-a9d6-f4e4cd5ee045,53ed8b95-f650-42a3-b650-db28e9086a4d,32b575bb-c409-4dd0-9053-ca3eadfd2fbf,400a1991-e2a2-4962-be79-33c47dd25c43,f89a0373-5484-48aa-bed7-aa6ffa00f573,6884978d-aae7-4d84-8b20-0bcd0a4e1481,3140be3f-b4aa-4d63-bef1-3f090b5f214d,fa45db83-73c5-4305-8340-cd33a9c5fcb1,c62664fe-1a6c-4b2a-a861-c1ddcdb7d4c4,880d7d99-5be7-401e-a02a-bbfdf3317e5a,aded81d0-a069-49d0-8810-c8b9fa16f224"
