Tcl2 proc StringConcatenator_6_evaluator {} {    if {{OUTGOING} == {OUTGOING}} {      set attr [FME_DecodeText {_request_url}];      if {[string length $attr] == 0} { return; };      set attrs [list [FME_EncodeText $attr]];    } else {      set attrAll {<Unused>};      if {[string length $attrAll] == 0} { return; };      set attrs [split {<Unused>} { }];    };    set parmList {{EvaluateExpression} {ATTR_CREATE_EXPR_PROPOGATE_MISSING_FDIV}};    foreach attr $attrs {     lappend parmList $attr;     lappend parmList {"<at>Value<openparen>col1<closeparen><at>Value<openparen>col0<closeparen>"};    };    lappend parmList {StringConcatenator_6};    eval FME_Execute $parmList; }
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { StringConcatenator_6 }    INPUT  FEATURE_TYPE StringReplacer_3_OUTPUT    OUTPUT { FEATURE_TYPE StringConcatenator_6_OUTPUT         @Tcl2("StringConcatenator_6_evaluator ")          }
# -------------------------------------------------------------------------
Tcl2 proc StringConcatenator_4_evaluator {} {    if {{OUTGOING} == {OUTGOING}} {      set attr [FME_DecodeText {_response_url}];      if {[string length $attr] == 0} { return; };      set attrs [list [FME_EncodeText $attr]];    } else {      set attrAll {<Unused>};      if {[string length $attrAll] == 0} { return; };      set attrs [split {<Unused>} { }];    };    set parmList {{EvaluateExpression} {ATTR_CREATE_EXPR_PROPOGATE_MISSING_FDIV}};    foreach attr $attrs {     lappend parmList $attr;     lappend parmList {"$(OutputDirectory$encode)<solidus><at>Value<openparen>col0<closeparen>"};    };    lappend parmList {StringConcatenator_4};    eval FME_Execute $parmList; }
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { StringConcatenator_4 }    INPUT  FEATURE_TYPE StringConcatenator_6_OUTPUT    OUTPUT { FEATURE_TYPE StringConcatenator_4_OUTPUT         @Tcl2("StringConcatenator_4_evaluator ")          }
