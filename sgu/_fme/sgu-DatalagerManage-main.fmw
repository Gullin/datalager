#! START_WB_HEADER
MACRO WB_KEYWORD "SDF3_1"
#! END_WB_HEADER
#! START_DEST_HEADER SDF3 SDF3_1
# =====================================================================
# The following GUI line prompts for a folder to be used as the
# the destination for the SDF3 files. The user input is stored in
# a macro, which is then used to define the dataset to be written.
#! END_DEST_HEADER
#! START_WB_HEADER
DEFAULT_MACRO DestDataset
INCLUDE [ if {"$(DestDataset)" != ""} {                          \
 puts {DEFAULT_MACRO DestDataset_SDF3_1 $(DestDataset)}         \
 } ]
#! END_WB_HEADER
#! START_DEST_HEADER SDF3 SDF3_1
DEFAULT_MACRO DestDataset_SDF3_1 $(OutputDirectory)
GUI FILENAME DestDataset_SDF3_1 SDF_Files(*.sdf)|*.sdf|All_files(*)|* Destination Autodesk MapGuide Enterprise SDF File:
SDF3_1_EXTENT_TYPE Static
DEFAULT_MACRO SDF3_OUT_OVERWRITE_FILE_SDF3_1 Yes
SDF3_1_OVERWRITE_FILE "$(SDF3_OUT_OVERWRITE_FILE_SDF3_1)"
GUI OPTIONAL CHECKBOX SDF3_OUT_OVERWRITE_FILE_SDF3_1 Yes%No Overwrite Existing File
DEFAULT_MACRO SDF3_OUT_DEFAULT_SCHEMA_NAME_SDF3_1 Default
SDF3_1_DEFAULT_SCHEMA_NAME "$(SDF3_OUT_DEFAULT_SCHEMA_NAME_SDF3_1)"
GUI OPTIONAL TEXT SDF3_OUT_DEFAULT_SCHEMA_NAME_SDF3_1 Default Schema Name:
DEFAULT_MACRO SDF3_OUT_TABLE_DEFAULTS_SDF3_1 
GUI OPTIONAL DISCLOSUREGROUP SDF3_OUT_TABLE_DEFAULTS_SDF3_1 OverwriteTable%WRITER_MODE%IdentityColumnName%GeometryColumnName Table Defaults
DEFAULT_MACRO SDF3_OUT_OverwriteTable_SDF3_1 NO
SDF3_1_OverwriteTable "$(SDF3_OUT_OverwriteTable_SDF3_1)"
GUI CHOICE SDF3_OUT_OverwriteTable_SDF3_1 YES%NO%Truncate Overwrite Table
DEFAULT_MACRO SDF3_OUT_WRITER_MODE_SDF3_1 INSERT
SDF3_1_WRITER_MODE "$(SDF3_OUT_WRITER_MODE_SDF3_1)"
GUI LOOKUP_CHOICE SDF3_OUT_WRITER_MODE_SDF3_1 Insert,INSERT%Update,UPDATE%Delete,DELETE Writer Mode
DEFAULT_MACRO SDF3_OUT_IdentityColumnName_SDF3_1 PRIMARYINDEX
SDF3_1_IdentityColumnName "$(SDF3_OUT_IdentityColumnName_SDF3_1)"
GUI OPTIONAL TEXT SDF3_OUT_IdentityColumnName_SDF3_1 Default auto-generated identity column
DEFAULT_MACRO SDF3_OUT_GeometryColumnName_SDF3_1 GEOM
SDF3_1_GeometryColumnName "$(SDF3_OUT_GeometryColumnName_SDF3_1)"
GUI OPTIONAL TEXT SDF3_OUT_GeometryColumnName_SDF3_1 Geometry Column Name
DEFAULT_MACRO SDF3_OUT_ADVANCED_SDF3_1 
GUI OPTIONAL DISCLOSUREGROUP SDF3_OUT_ADVANCED_SDF3_1 XY_TOLERANCE%Z_TOLERANCE Advanced
DEFAULT_MACRO SDF3_OUT_XY_TOLERANCE_SDF3_1 0.0005
SDF3_1_XY_TOLERANCE "$(SDF3_OUT_XY_TOLERANCE_SDF3_1)"
GUI OPTIONAL FLOAT SDF3_OUT_XY_TOLERANCE_SDF3_1 X/Y Tolerance
DEFAULT_MACRO SDF3_OUT_Z_TOLERANCE_SDF3_1 0.0005
SDF3_1_Z_TOLERANCE "$(SDF3_OUT_Z_TOLERANCE_SDF3_1)"
GUI OPTIONAL FLOAT SDF3_OUT_Z_TOLERANCE_SDF3_1 Z Tolerance
# ============================================================================
# Opt in for destination dataset type vs format type validation
DEFAULT_MACRO SDF3_OUT_DESTINATION_DATASETTYPE_VALIDATION_SDF3_1 Yes
SDF3_1_DESTINATION_DATASETTYPE_VALIDATION "$(SDF3_OUT_DESTINATION_DATASETTYPE_VALIDATION_SDF3_1)"
SDF3_1_DATASET "$(DestDataset_SDF3_1)"
SDF3_1_GENERATE_FME_BUILD_NUM 17259
#! END_DEST_HEADER
#! START_WB_HEADER
MACRO WB_KEYWORD "SHAPEFILE_1"
#! END_WB_HEADER
#! START_DEST_HEADER SHAPEFILE SHAPEFILE_1
# ============================================================================
# The following GUI line prompts for a folder to be used as the
# the destination for the Esri Shapefiles.
# The user input is stored in a macro, which is then used to define
# the dataset to be written.
#! END_DEST_HEADER
#! START_WB_HEADER
DEFAULT_MACRO DestDataset
INCLUDE [ if {"$(DestDataset)" != ""} {                          \
 puts {DEFAULT_MACRO DestDataset_SHAPEFILE_1 $(DestDataset)}         \
 } ]
#! END_WB_HEADER
#! START_DEST_HEADER SHAPEFILE SHAPEFILE_1
DEFAULT_MACRO DestDataset_SHAPEFILE_1 $(OutputDirectory)
GUI DIRNAME DestDataset_SHAPEFILE_1 Destination Esri Shapefile Folder:
SHAPEFILE_1_COORDINATE_SYSTEM_GRANULARITY FEATURE_TYPE
DEFAULT_MACRO SHAPEFILE_OUT_WRITER_PARAMS_SHAPEFILE_1 FME_DISCLOSURE_OPEN
GUI OPTIONAL DISCLOSUREGROUP SHAPEFILE_OUT_WRITER_PARAMS_SHAPEFILE_1 SHAPEFILE_OUT_ENCODING_SHAPEFILE_1%SHAPEFILE_OUT_SPATIAL_INDEXES_SHAPEFILE_1%SHAPEFILE_OUT_COMPRESSED_FILE_SHAPEFILE_1%SHAPEFILE_OUT_DIMENSION%SHAPEFILE_OUT_DATETIME_STORAGE_SHAPEFILE_1 Writer Parameters
# ============================================================================
# The following keyword allows the user to choose what encoding to
# use for outputting the shapefile
DEFAULT_MACRO SHAPEFILE_OUT_ENCODING_SHAPEFILE_1 windows-1252
SHAPEFILE_1_ENCODING "$(SHAPEFILE_OUT_ENCODING_SHAPEFILE_1)"
GUI STRING_OR_ENCODING SHAPEFILE_OUT_ENCODING_SHAPEFILE_1 fme-source-encoding%fme-system%* Character Encoding
# ============================================================================
# Specifies whether or not the reader will generate spatial index files
DEFAULT_MACRO SHAPEFILE_OUT_SPATIAL_INDEXES_SHAPEFILE_1 BOTH
SHAPEFILE_1_SPATIAL_INDEXES "$(SHAPEFILE_OUT_SPATIAL_INDEXES_SHAPEFILE_1)"
GUI LOOKUP_CHOICE SHAPEFILE_OUT_SPATIAL_INDEXES_SHAPEFILE_1 None,NONE%"\"ArcGIS Compatible Spatial Index (.sbn)\",SBN"%"\"QGIS and MapServer Spatial Index (.qix)\",QIX"%"\"Both ArcGIS and QGIS/MapServer Compatible (.sbn<space>and<space>.qix)\",BOTH" Create Spatial Index:
DEFAULT_MACRO SHAPEFILE_OUT_COMPRESSED_FILE_SHAPEFILE_1 No
SHAPEFILE_1_COMPRESSED_FILE "$(SHAPEFILE_OUT_COMPRESSED_FILE_SHAPEFILE_1)"
GUI OPTIONAL CHECKBOX SHAPEFILE_OUT_COMPRESSED_FILE_SHAPEFILE_1 Yes%No Create Compressed Shapefile (.shz)
DEFAULT_MACRO SHAPEFILE_OUT_DIMENSION_SHAPEFILE_1 2D
SHAPEFILE_1_DIMENSION "$(SHAPEFILE_OUT_DIMENSION_SHAPEFILE_1)"
DEFAULT_MACRO SHAPEFILE_OUT_DATETIME_STORAGE_SHAPEFILE_1 TIMESTAMP_STRING
SHAPEFILE_1_DATETIME_STORAGE "$(SHAPEFILE_OUT_DATETIME_STORAGE_SHAPEFILE_1)"
GUI LOOKUP_CHOICE SHAPEFILE_OUT_DATETIME_STORAGE_SHAPEFILE_1 "\"As String <openparen>FME Datetime Format<closeparen>\",TIMESTAMP_STRING"%"\"Date <openparen>YYYYMMDD only<closeparen>\",DATE_ONLY" Datetime Type Storage
DEFAULT_MACRO SHAPEFILE_OUT_ADVANCED_SHAPEFILE_1 
GUI OPTIONAL DISCLOSUREGROUP SHAPEFILE_OUT_ADVANCED_SHAPEFILE_1 SHAPEFILE_OUT_SURFACE_SOLID_STORAGE_SHAPEFILE_1%SHAPEFILE_OUT_MEASURES_AS_Z_SHAPEFILE_1%SHAPEFILE_OUT_DATASET_SPLITTING_SHAPEFILE_1 Advanced
DEFAULT_MACRO SHAPEFILE_OUT_SURFACE_SOLID_STORAGE_SHAPEFILE_1 PATCH
SHAPEFILE_1_SURFACE_SOLID_STORAGE "$(SHAPEFILE_OUT_SURFACE_SOLID_STORAGE_SHAPEFILE_1)"
GUI LOOKUP_CHOICE SHAPEFILE_OUT_SURFACE_SOLID_STORAGE_SHAPEFILE_1 Multipatch,PATCH%Polygon,POLYGON Surface and Solid Storage
# ============================================================================
# The following GUI line sets whether measure values in the shapefiles should
# be treated as elevations.
DEFAULT_MACRO SHAPEFILE_OUT_MEASURES_AS_Z_SHAPEFILE_1 No
SHAPEFILE_1_MEASURES_AS_Z "$(SHAPEFILE_OUT_MEASURES_AS_Z_SHAPEFILE_1)"
GUI CHOICE SHAPEFILE_OUT_MEASURES_AS_Z_SHAPEFILE_1 Yes%No Treat Elevation as Measures
DEFAULT_MACRO SHAPEFILE_OUT_DATASET_SPLITTING_SHAPEFILE_1 Yes
SHAPEFILE_1_DATASET_SPLITTING "$(SHAPEFILE_OUT_DATASET_SPLITTING_SHAPEFILE_1)"
GUI OPTIONAL CHECKBOX SHAPEFILE_OUT_DATASET_SPLITTING_SHAPEFILE_1 Yes%No Split Dataset into 2GB Files
# ============================================================================
# Opt in for destination dataset type vs format type validation
DEFAULT_MACRO SHAPEFILE_OUT_DESTINATION_DATASETTYPE_VALIDATION_SHAPEFILE_1 Yes
SHAPEFILE_1_DESTINATION_DATASETTYPE_VALIDATION "$(SHAPEFILE_OUT_DESTINATION_DATASETTYPE_VALIDATION_SHAPEFILE_1)"
# ============================================================================
SHAPEFILE_1_GENERATE_FME_BUILD_NUM 21306
