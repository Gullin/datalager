_FILTERS Yes CASE_SENSITIVE_FEATURE_TYPES YES ALLOW_DOLLAR_SIGNS YES CREATE_FEATURE_TABLES_FROM_DATA Yes STRIP_SHEETNAME_SPACES YES KEEP_SCHEMA_SETTINGS YES
