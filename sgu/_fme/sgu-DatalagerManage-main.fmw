FACTORY_DEF {*} AggregateFactory    FACTORY_NAME { Aggregator_2 }    INPUT  FEATURE_TYPE AttributeManager_OUTPUT    MODE { ONE_LEVEL }    GROUP_BY { fme_feature_type fme_feature_type_name fme_format_long_name fme_format_short_name dl_new_feature_type_name }    FLUSH_WHEN_GROUPS_CHANGE { No }    REMOVE_GEOMETRY { NO }    COUNT_ATTRIBUTE { "Antal" }    ACCUMULATE_ATTRIBUTES { One }    LIST_NAME "attribute{}"    LIST_ATTRS_TO_INCLUDE { fme_data_type name native_data_type }    LIST_ATTRS_TO_INCLUDE_MODE { SELECTED }    SEPARATOR { <comma> }    PRODUCE_MULTIS { YES }    OUTPUT { AGGREGATE FEATURE_TYPE Aggregator_2_AGGREGATE          }
