MACRO casemac
INCLUDE [ if { {no} == {no} } { puts {MACRO casemac -nocase}} ]
Tcl2 proc $(FME_UUID_SAFE)_replace {} {    set attrs [split {DatasetName} { }];    set mapping [FME_DecodeText {"<u00e5><space>a<space><u00c5><space>a<space><u00e4><space>a<space><u00c4><space>a<space><u00f6><space>o<space><u00d6><space>o"}];    foreach attr $attrs {       set attrName [FME_DecodeText $attr];       FME_SetAttribute $attrName [string map $(casemac) $mapping [FME_GetAttribute $attrName]];    }; }
