FACTORY_DEF {*} AttrSetFactory    COMMAND_PARM_EVALUATION SINGLE_PASS    FACTORY_NAME { AttributeManager }    INPUT  FEATURE_TYPE Tester_PASSED    MULTI_FEATURE_MODE { NO }    NULL_ATTR_MODE { NO_OP }    ATTRSET_CREATE_DIRECTIVES _PROPAGATE_MISSING_FDIV    ACTION_COLUMN 3    DEF_VAL_COLUMN 2    MISSING_INPUT_ATTR_HANDLING RENAME_SET_VALUE REMOVE    ATTR_ACTION { "filter_fme_feature_type" "filter_fme_feature_type" "" "REMOVE" }      ATTR_ACTION { "filter_export_column" "filter_export_column" "" "REMOVE" }      ATTR_ACTION { "column_name" "column_name" "" "REMOVE" }      ATTR_ACTION { "dl_need_new_column_name" "dl_need_new_column_name" "" "REMOVE" }      ATTR_ACTION { "dl_new_column_name" "name" "" "RENAME_SET_VALUE" }      ATTR_ACTION { "dl_export" "dl_export" "" "REMOVE" }      ATTR_ACTION { "_dirpath" "_dirpath" "" "REMOVE" }      ATTR_ACTION { "_extension" "_extension" "" "REMOVE" }      ATTR_ACTION { "DatasetFull" "DatasetFull" "" "REMOVE" }      ATTR_ACTION { "Dataset" "Dataset" "" "REMOVE" }      ATTR_ACTION { "column_name_char_length" "column_name_char_length" "" "REMOVE" }      ATTR_ACTION { "dl_need_new_feature_type_name" "dl_need_new_feature_type_name" "" "REMOVE" }      ATTR_ACTION { "feature_type_name_naming_convention" "feature_type_name_naming_convention" "" "REMOVE" }      ATTR_ACTION { "column_name_naming_convention" "column_name_naming_convention" "" "REMOVE" }      ATTR_ACTION { "test_naming_convention" "test_naming_convention" "" "REMOVE" }    OUTPUT { OUTPUT FEATURE_TYPE AttributeManager_OUTPUT        }
