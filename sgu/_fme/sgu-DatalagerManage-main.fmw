Tcl2 proc StringConcatenator_12_evaluator {} {    if {{OUTGOING} == {OUTGOING}} {      set attr [FME_DecodeText {Logg}];      if {[string length $attr] == 0} { return; };      set attrs [list [FME_EncodeText $attr]];    } else {      set attrAll {<Unused>};      if {[string length $attrAll] == 0} { return; };      set attrs [split {<Unused>} { }];    };    set parmList {{EvaluateExpression} {ATTR_CREATE_EXPR_PROPOGATE_MISSING_FDIV}};    foreach attr $attrs {     lappend parmList $attr;     lappend parmList {"Dataset<openparen>en<closeparen><space><at>Value<openparen>fme_feature_type<closeparen><space>har<space>ej<space>l<u00e4>nkats<space>till<space>n<u00e5>got<space>schema.<space>Kommer<space>ej<space>att<space>kunna<space>skapas<space>med<space>attribut.<space>Kontrollera<space>anledningen<space>till<space>att<space>dataset<space><u00e5>kt<space>igenom<space>utan<space>upptagning<space>p<u00e5><space>korrekt<space>s<u00e4>tt<space>i<space>schemahanteringen."};    };    lappend parmList {StringConcatenator_12};    eval FME_Execute $parmList; }
